// Deploy with: firebase deploy --only firestore:rules,firestore:indexes
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return request.auth.uid == userID;
    }

    // A moderator. The `admin` claim is minted out of band by
    // `scripts/set_admin_claim.js`, so it can't be self-assigned; map.get() makes a missing claim false.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // True when `a` and `b` have an accepted friend edge. The edge id is the two
    // sorted participants and rules can't sort, so both orders are probed.
    function areFriends(a, b) {
      return (exists(/databases/$(database)/documents/friendEdges/$(a + '_' + b))
              && get(/databases/$(database)/documents/friendEdges/$(a + '_' + b)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendEdges/$(b + '_' + a))
              && get(/databases/$(database)/documents/friendEdges/$(b + '_' + a)).data.status == 'accepted');
    }

    // Anonymous guests may browse but not write; this makes the UI restriction a security boundary.
    function isFullMember() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // True when `ownerID`'s private profile blocks `otherID`. get() runs elevated,
    // so it reads the owner-only doc; a missing doc or field means not blocked.
    function hasBlocked(ownerID, otherID) {
      return exists(/databases/$(database)/documents/users/$(ownerID)/private/profile)
          && get(/databases/$(database)/documents/users/$(ownerID)/private/profile)
               .data.get('blockedUserIDs', []).hasAny([otherID]);
    }

    // A block severs the thread both ways; checking only the recipient's list let
    // a blocker write to the person they blocked via a direct write. `||` short-circuits.
    function blockedEitherWay(userA, userB) {
      return hasBlocked(userA, userB) || hasBlocked(userB, userA);
    }

    // True when the caller hosts the listing. get() runs elevated, so it works from
    // subcollection rules; denies when the listing is gone. This is identity, distinct
    // from `isListingManager`: a co-host isn't the host, and stay-request recipients,
    // address grants and deletion all ask this one.
    function isListingHost(homeID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == request.auth.uid;
    }

    // True when the caller may manage the listing: its host or a named co-host.
    // The listing's description and private subdocuments ask this, since a
    // roommate who can't read the address can't let a guest in.
    function isListingManager(homeID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && (get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == request.auth.uid
              || get(/databases/$(database)/documents/homes/$(homeID))
                   .data.get('coHostUserIDs', []).hasAny([request.auth.uid]));
    }

    // True when the caller may answer a stay request with the host's authority: the
    // host on the request or a co-host of its listing. A co-host who could read the
    // address and block dates but not see bookings had half a job. `isOwner` comes
    // first so the host's own path costs no extra read. Takes the document since
    // callers hold `resource.data`; safe on create, where `resource` is null
    // (covered by rules-tests/requests.test.mjs).
    function isHostSide(data) {
      return isOwner(data.hostUserID) || isListingManager(data.listingID);
    }

    // True when `homeID` is a live listing whose host is exactly `claimedHostID`,
    // stopping a guest fabricating a request naming a victim host or a dead
    // listing. get() is elevated, so it works for friends-only listings.
    function listingHasActiveHost(homeID, claimedHostID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == claimedHostID
          && get(/databases/$(database)/documents/homes/$(homeID)).data.get('deletedAt', null) == null;
    }

    // The listing's advertised capacity, bounding a request's party size. The engine caches duplicate get()s.
    function listingMaxGuests(homeID) {
      return get(/databases/$(database)/documents/homes/$(homeID)).data.guestPolicy.maxGuests;
    }

    // -------------------------------------------------------------------------
    // Circles: friend-grouped booking rules (docs/internal/CIRCLES.md).
    //
    // A restricted friend is never told: no decline, no error, nothing on screen
    // distinguishes a rule from a busy week. So these rules are the only
    // enforcement that counts; the client only hides what it mustn't offer.
    //
    // Resolution order, matched by CirclePolicyResolver in the client:
    // per-friend override, then the friend's circle, then Default. It always
    // terminates because Default lives at a fixed document id. A host with no
    // circles (migration not run) restricts nothing, as before.
    // -------------------------------------------------------------------------

    function defaultCircleID() { return 'default'; }

    // Mirrors ArrivalWindow in the client and the stay request whitelist; rules-tests/mirrors.test.mjs checks all three.
    function arrivalOptions() {
      return ['flexible', 'morning', 'afternoon', 'evening', 'lateNight'];
    }

    function circlePath(hostID, circleID) {
      return /databases/$(database)/documents/users/$(hostID)/circles/$(circleID);
    }

    function membershipPath(hostID, friendID) {
      return /databases/$(database)/documents/users/$(hostID)/circleMembers/$(friendID);
    }

    // The shape of a policy wherever stored (circle, override, resolved projection); bounds mirror BookingPolicy / StayFrequencyCap.
    function isValidBookingPolicy(policy) {
      return policy is map
          && policy.keys().hasOnly(['allowedArrivalOptions', 'minNoticeHours', 'maxStaysPerPeriod'])
          && policy.keys().hasAll(['allowedArrivalOptions', 'minNoticeHours'])
          && policy.allowedArrivalOptions is list
          && policy.allowedArrivalOptions.size() > 0
          && policy.allowedArrivalOptions.size() <= 5
          && policy.allowedArrivalOptions.hasOnly(arrivalOptions())
          && policy.minNoticeHours is int
          && policy.minNoticeHours >= 0
          && policy.minNoticeHours <= 8760
          // Absent means uncapped; no sentinel count stands in for "unlimited".
          && (policy.get('maxStaysPerPeriod', null) == null
              || (policy.maxStaysPerPeriod is map
                  && policy.maxStaysPerPeriod.keys().hasOnly(['count', 'periodDays'])
                  && policy.maxStaysPerPeriod.count is int
                  && policy.maxStaysPerPeriod.count >= 1
                  && policy.maxStaysPerPeriod.count <= 100
                  && policy.maxStaysPerPeriod.periodDays is int
                  && policy.maxStaysPerPeriod.periodDays >= 1
                  && policy.maxStaysPerPeriod.periodDays <= 3650));
    }

    // Resolution passes the document it just read down as an argument rather than
    // re-reading it: rules have no local bindings, and re-resolving from four places
    // once blew the 1000-expression budget.

    // 0 for non-ints, so a malformed policy degrades to "no minimum".
    function noticeHours(p) {
      return p.get('minNoticeHours', 0) is int ? p.get('minNoticeHours', 0) : 0;
    }

    // 0 means uncapped, including an absent or malformed cap.
    function capCountOf(p) {
      return p.get('maxStaysPerPeriod', null) == null
           ? 0
           : (p.maxStaysPerPeriod.get('count', 0) is int ? p.maxStaysPerPeriod.get('count', 0) : 0);
    }

    function capPeriodDaysOf(p) {
      return p.get('maxStaysPerPeriod', null) == null
           ? 0
           : (p.maxStaysPerPeriod.get('periodDays', 0) is int ? p.maxStaysPerPeriod.get('periodDays', 0) : 0);
    }

    // Whether policy `p` admits this booking. An absent arrivalWindow reads as
    // 'flexible', not unchecked. checkIn is a local start-of-day and the client rounds
    // the horizon up to a whole day (BookingPolicy.earliestCheckIn), so both agree on
    // the first bookable day. `needsSlot` is false when editing a request that already spent one.
    function policyPermits(p, hostID, friendID, data, needsSlot) {
      return data.get('arrivalWindow', 'flexible')
               in p.get('allowedArrivalOptions', arrivalOptions())
          // Zero is skipped: `checkIn >= request.time` would reject same-day requests,
          // and "no minimum notice" must mean the pre-Circles behaviour.
          && (noticeHours(p) == 0
              || data.checkIn >= request.time + duration.value(noticeHours(p), 'h'))
          && (!needsSlot
              || capCountOf(p) == 0
              || stayCounterAdvanced(hostID, friendID));
    }

    function circleHasPolicy(hostID, circleID) {
      return exists(circlePath(hostID, circleID))
          && 'policy' in get(circlePath(hostID, circleID)).data;
    }

    // The named circle, falling back to Default if deleted, and to no restriction if the host has no circles.
    function circlePermits(hostID, circleID, friendID, data, needsSlot) {
      return circleHasPolicy(hostID, circleID)
           ? policyPermits(get(circlePath(hostID, circleID)).data.policy, hostID, friendID, data, needsSlot)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? policyPermits(get(circlePath(hostID, defaultCircleID())).data.policy,
                              hostID, friendID, data, needsSlot)
              : true);
    }

    // A per-friend override supersedes the circle.
    function membershipPermits(hostID, member, friendID, data, needsSlot) {
      return member.get('overridePolicy', null) != null
           ? policyPermits(member.overridePolicy, hostID, friendID, data, needsSlot)
           : circlePermits(hostID, member.get('circleID', defaultCircleID()), friendID, data, needsSlot);
    }

    // The entry point: does `hostID`'s configuration admit this booking from
    // `friendID`? A friend without a membership doc is governed by Default.
    function bookingPermitted(hostID, friendID, data, needsSlot) {
      return exists(membershipPath(hostID, friendID))
           ? membershipPermits(hostID, get(membershipPath(hostID, friendID)).data, friendID, data, needsSlot)
           : circlePermits(hostID, defaultCircleID(), friendID, data, needsSlot);
    }

    // The cap and window governing a pair, as numbers; 0 means uncapped.
    function pairCapCount(hostID, friendID) {
      return exists(membershipPath(hostID, friendID))
           ? membershipCapCount(hostID, get(membershipPath(hostID, friendID)).data)
           : circleCapCount(hostID, defaultCircleID());
    }

    function membershipCapCount(hostID, member) {
      return member.get('overridePolicy', null) != null
           ? capCountOf(member.overridePolicy)
           : circleCapCount(hostID, member.get('circleID', defaultCircleID()));
    }

    function circleCapCount(hostID, circleID) {
      return circleHasPolicy(hostID, circleID)
           ? capCountOf(get(circlePath(hostID, circleID)).data.policy)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? capCountOf(get(circlePath(hostID, defaultCircleID())).data.policy)
              : 0);
    }

    function pairCapPeriodDays(hostID, friendID) {
      return exists(membershipPath(hostID, friendID))
           ? membershipCapPeriodDays(hostID, get(membershipPath(hostID, friendID)).data)
           : circleCapPeriodDays(hostID, defaultCircleID());
    }

    function membershipCapPeriodDays(hostID, member) {
      return member.get('overridePolicy', null) != null
           ? capPeriodDaysOf(member.overridePolicy)
           : circleCapPeriodDays(hostID, member.get('circleID', defaultCircleID()));
    }

    function circleCapPeriodDays(hostID, circleID) {
      return circleHasPolicy(hostID, circleID)
           ? capPeriodDaysOf(get(circlePath(hostID, circleID)).data.policy)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? capPeriodDaysOf(get(circlePath(hostID, defaultCircleID())).data.policy)
              : 0);
    }

    function stayCounterPath(hostID, guestID) {
      return /databases/$(database)/documents/stayCounters/$(hostID + '_' + guestID);
    }

    // The frequency cap, enforced as a query-less rule can: the guest advances a
    // counter in the same commit and this requires it. Same shape and caveat as
    // rateCounterAdvanced() below (batched creates share a slot; App Check is the main control).
    function stayCounterAdvanced(hostID, guestID) {
      return (getAfter(stayCounterPath(hostID, guestID)).data.windowStart == request.time
              && getAfter(stayCounterPath(hostID, guestID)).data.count == 1)
          || (exists(stayCounterPath(hostID, guestID))
              && getAfter(stayCounterPath(hostID, guestID)).data.count
                 == get(stayCounterPath(hostID, guestID)).data.count + 1);
    }

    // The keys an update touches; anything outside the caller's allowlist is pinned.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when this write also advances the caller's rateLimits counter in the same
    // commit (a fresh window resetting to 1 at request.time, or an increment).
    // getAfter() reads the post-commit state, so every send consumes a slot. Caveat:
    // N batched creates with one increment share a slot since rules can't count
    // siblings; App Check is the primary control against hand-rolled clients.
    function rateCounterAdvanced(uid) {
      return (getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.windowStart == request.time
              && getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.count == 1)
          || (exists(/databases/$(database)/documents/rateLimits/$(uid))
              && getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.count
                 == get(/databases/$(database)/documents/rateLimits/$(uid)).data.count + 1);
    }

    // Optional-field helpers. The Swift encoder omits nil but seed/admin writes use
    // null, so absent and null both mean unset. Fields are read by string with map.get().
    function isUnset(data, field) {
      return data.get(field, null) == null;
    }

    function isOptionalString(data, field, maxLength) {
      return isUnset(data, field)
          || (data.get(field, '') is string
              && data.get(field, '').size() <= maxLength);
    }

    function isOptionalList(data, field, maxCount) {
      return isUnset(data, field)
          || (data.get(field, []) is list
              && data.get(field, []).size() <= maxCount);
    }

    // A message may carry a structured stay event. When present it must be a
    // well-formed map with a known kind, so a modified client can't smuggle data
    // into a system card. The kinds mirror StayEvent.Kind in MessageStore.swift.
    function validMessageEvent(data) {
      return isUnset(data, 'event')
          || (data.event is map
              && data.event.keys().hasOnly(['kind', 'dateRange', 'note', 'listingID'])
              && data.event.kind is string
              && data.event.kind in ['requested', 'offered', 'accepted', 'declined', 'cancelled', 'modified', 'hostCancelled']
              && data.event.dateRange is string
              && data.event.dateRange.size() > 0
              && data.event.dateRange.size() < 200
              && isOptionalString(data.event, 'note', 2000)
              // The listing the event refers to, for the card's way back; optional and capped as a document id.
              && isOptionalString(data.event, 'listingID', 200));
    }

    // -------------------------------------------------------------------------
    // Users
    // The user document is a public projection (displayName, timestamps,
    // trustStats) readable by any full member. PII and safety data live in the
    // owner-only `private/profile` subdocument. Only the owner creates/updates;
    // deletes go through a Cloud Function cascade.
    // -------------------------------------------------------------------------
    match /users/{userID} {
      // The public user doc holds exactly these keys; hasOnly() stops it becoming a
      // spam surface and hasAll() stops a merge dropping a field. `trustStats` is
      // optional since only recomputeTrustStats writes it (admin bypasses this).
      // The name-search index (UserSearchTerms) is optional until
      // scripts/backfill_search_terms.js runs. Rules can't loop, so prefixes aren't
      // checked against the name; the size cap bounds abuse and the whole lowercased
      // displayName must be present. Being findable isn't access. onUserWritten should own this field.
      function isValidSearchTerms(data) {
        return isUnset(data, 'searchTerms')
            || (data.searchTerms is list
                && data.searchTerms.size() <= 60
                && data.searchTerms.hasAll([data.displayName.lower()]));
      }

      function isValidPublicProfile(data) {
        return data.keys().hasOnly(['displayName', 'searchTerms', 'createdAt', 'updatedAt', 'trustStats'])
            && data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
            && data.displayName is string
            && data.displayName.size() > 0
            && data.displayName.size() < 200
            && isValidSearchTerms(data)
            && data.createdAt is timestamp
            && data.updatedAt == request.time;
      }

      // Full members only, so an anonymous guest can't enumerate users. Elevated get()/exists() still read it.
      allow read: if isFullMember();

      allow create: if isSignedIn()
          && isOwner(userID)
          && isValidPublicProfile(request.resource.data)
          && request.resource.data.createdAt == request.time
          // Reputation is earned, never claimed on the way in.
          && isUnset(request.resource.data, 'trustStats');

      allow update: if isSignedIn()
          && isOwner(userID)
          && isValidPublicProfile(request.resource.data)
          // createdAt must not change
          && request.resource.data.createdAt == resource.data.createdAt
          // Nor trustStats, so a host can't award themselves badges; Cloud Functions bypass this.
          && request.resource.data.get('trustStats', null) == resource.data.get('trustStats', null);

      allow delete: if false;

      // Owner-only private data; Cloud Functions reach it through elevated get()/exists().
      match /private/{docID} {
        allow read, write: if isSignedIn() && isOwner(userID);
      }

      // The host's circles, owner-only both ways: a circle *name* ("Acquaintance")
      // is the decline this feature spares people. With no field-level read rules,
      // what guests need is projected into `bookingPolicies` below.
      match /circles/{circleID} {
        function isValidCircle(data) {
          return data.keys().hasOnly(['name', 'isDefault', 'sortOrder', 'policy', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['name', 'isDefault', 'sortOrder', 'policy'])
              && data.name is string
              && data.name.size() > 0
              && data.name.size() <= 40
              && data.sortOrder is int
              // Being Default is a fact about the document id, never a claim in the document.
              && data.isDefault == (circleID == defaultCircleID())
              && isValidBookingPolicy(data.policy);
        }

        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidCircle(request.resource.data);
        // Default can't be deleted: a new friend needs somewhere to land.
        allow delete: if isSignedIn() && isOwner(userID) && circleID != defaultCircleID();
      }

      // Which circle each friend is in plus any per-person policy, keyed by uid so a booking resolves in one get().
      match /circleMembers/{friendID} {
        function isValidMembership(data) {
          return data.keys().hasOnly(['circleID', 'overridePolicy', 'updatedAt'])
              && data.keys().hasAll(['circleID'])
              && data.circleID is string
              && data.circleID.size() > 0
              && data.circleID.size() <= 200
              && (data.get('overridePolicy', null) == null
                  || isValidBookingPolicy(data.overridePolicy));
        }

        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidMembership(request.resource.data);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The resolved policy projected for one guest, who reads only their own. It
      // carries the three rules and nothing that reveals the host sorts anyone. A
      // display cache: the rules above are the boundary, and this lets the request
      // sheet not offer what would be refused.
      match /bookingPolicies/{guestID} {
        allow read: if isSignedIn() && (isOwner(userID) || isOwner(guestID));
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidBookingPolicy(request.resource.data);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The host's private notes on friends. Read is the owner and nobody else (not
      // the friend, a moderator, or a Cloud Function), so "private" means the
      // document, not the screen. No second read branch, and nothing projects a note,
      // count or score to anyone. `isAdmin()` appears only on `reports`, so no ambient
      // moderator read widens this.
      match /friendNotes/{noteID} {
        function isValidNote(data) {
          return data.keys().hasOnly(['subjectUserID', 'text', 'stayRequestID', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['subjectUserID', 'text'])
              && data.subjectUserID is string
              && data.subjectUserID.size() > 0
              && data.subjectUserID.size() <= 128
              // A note about yourself isn't what this is for, and would put host-authored text on a profile they might share.
              && data.subjectUserID != userID
              && data.text is string
              && data.text.size() > 0
              // Mirrors FriendNote.maxLength.
              && data.text.size() <= 2000
              && (data.get('stayRequestID', null) == null
                  || (data.stayRequestID is string
                      && data.stayRequestID.size() > 0
                      && data.stayRequestID.size() <= 200));
        }

        allow read: if isSignedIn() && isOwner(userID);

        allow create: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data);

        // Edits change the text (and may attach or clear a stay) but can't re-point the
        // note: a re-filed note keeps its date and reads as evidence about someone who
        // never sees it. `createdAt` is pinned.
        allow update: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data)
            && request.resource.data.subjectUserID == resource.data.subjectUserID
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

        allow delete: if isSignedIn() && isOwner(userID);
      }

      // Which note prompts the host answered or waved off, so the app asks once.
      // Separate from the notes: it says a prompt was seen and carries no text.
      match /friendNotePrompts/{stayRequestID} {
        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && request.resource.data.keys().hasOnly(['dismissedAt'])
            && request.resource.data.keys().hasAll(['dismissedAt']);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The guest's private notes on hosts and listings, the twin of `friendNotes`.
      // Same rules: read is the owner alone, no `isAdmin()` branch (moderation lives
      // at `reports`), and nothing projects a note, count or score. `subjectType`
      // says host or listing, `subjectID` is its id, and the update rule pins both so
      // a note can't be re-filed while keeping its date.
      match /guestNotes/{noteID} {
        function isValidNote(data) {
          return data.keys().hasOnly(['subjectType', 'subjectID', 'text', 'stayRequestID', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['subjectType', 'subjectID', 'text'])
              && data.subjectType in ['host', 'listing']
              && data.subjectID is string
              && data.subjectID.size() > 0
              && data.subjectID.size() <= 200
              // A `host` note about yourself is barred as with friend notes; a listing
              // you host is a different id space with no such profile.
              && !(data.subjectType == 'host' && data.subjectID == userID)
              && data.text is string
              && data.text.size() > 0
              // Mirrors GuestNote.maxLength.
              && data.text.size() <= 2000
              && (data.get('stayRequestID', null) == null
                  || (data.stayRequestID is string
                      && data.stayRequestID.size() > 0
                      && data.stayRequestID.size() <= 200));
        }

        allow read: if isSignedIn() && isOwner(userID);

        allow create: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data);

        // Edits can't re-point the note at a different host or listing, as with friend notes; `createdAt` is pinned.
        allow update: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data)
            && request.resource.data.subjectType == resource.data.subjectType
            && request.resource.data.subjectID == resource.data.subjectID
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

        allow delete: if isSignedIn() && isOwner(userID);
      }

      // Which post-trip note prompts the guest answered or waved off; mirrors `friendNotePrompts`.
      match /guestNotePrompts/{stayRequestID} {
        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && request.resource.data.keys().hasOnly(['dismissedAt'])
            && request.resource.data.keys().hasAll(['dismissedAt']);
        allow delete: if isSignedIn() && isOwner(userID);
      }
    }

    // -------------------------------------------------------------------------
    // Homes / Listings
    // Readable only by the host, co-hosts and `allowedViewerIDs` (the host's
    // accepted friends, denormalized since rules can't join to `friendEdges`).
    // Friends-of-friends appear only as suggestions.
    //
    // Clients can't query `homes` unfiltered, since a query is rejected if any
    // matched document fails the read rule. The feed uses `allowedViewerIDs
    // contains me`, which also covers the host's own listings.
    //
    // The legacy `visibility` field is rejected by the key allowlist below;
    // scripts/migrate_friends_only.js strips it and rebuilds ACLs. An unmigrated
    // document stays readable but can't be updated. Only the host writes listings.
    // -------------------------------------------------------------------------
    match /homes/{homeID} {
      // Every key the Home model encodes. Optionals are omitted when nil, so the tail uses hasOnly().
      function isValidListing(data) {
        return data.keys().hasOnly([
                 'id', 'hostUserID', 'hostName', 'title', 'address', 'description',
                 'contactPreference', 'hostContactInfo', 'hostMotivation',
                 'sleeping', 'guestPolicy', 'amenities', 'cancellationPolicy',
                 'photoURLs', 'unavailableDateRanges',
                 'latitude', 'longitude',
                 'geohash', 'allowedViewerIDs', 'coHostUserIDs',
                 'deletedAt', 'createdAt'
               ])
            && data.keys().hasAll([
                 'hostUserID', 'hostName', 'address',
                 'sleeping', 'guestPolicy', 'amenities'
               ])
            && data.hostUserID is string
            && data.hostName is string
            && data.hostName.size() > 0
            && data.hostName.size() < 200
            // Nested struct validation
            && data.address is map
            // The public address is city-level; `street` belongs in the private subdocument, and rejecting it here keeps it off the readable doc.
            && data.address.keys().hasOnly(['city', 'state', 'zip'])
            && data.address.keys().hasAll(['city', 'state'])
            // The city is copied onto every stay request, where it is capped at 100; uncapped here, a longer one
            // would validate on the listing and then reject every request against it.
            && data.address.city is string
            && data.address.city.size() > 0
            && data.address.city.size() <= 100
            && data.sleeping is map
            && data.guestPolicy is map
            && data.amenities is map
            && data.sleeping.numGuestRooms is int
            && data.guestPolicy.maxGuests is int
            && data.guestPolicy.maxStayDays is int
            // Size caps so a document can't be stuffed toward 1 MiB. The 60-char title cap mirrors CreateListingViewModel.titleMaxLength.
            && isOptionalString(data, 'title', 60)
            && isOptionalString(data, 'description', 2000)
            && isOptionalString(data, 'hostContactInfo', 500)
            && isOptionalList(data, 'photoURLs', 10)
            // The merged calendar, the only availability field this readable document
            // may carry. `blockedDateRanges` and `bookedDateRanges` are off the
            // allowlist on purpose: publishing both would let a viewer subtract one
            // from the other and learn which nights were occupied. They live in
            // `private/availability`. The cap is the sum of their former caps.
            && isOptionalList(data, 'unavailableDateRanges', 200)
            // Enums and coordinates: an undecodable value silently drops the listing from the feed.
            && (isUnset(data, 'contactPreference')
                || data.contactPreference in ['inApp', 'contactInfo'])
            && (isUnset(data, 'hostMotivation')
                || data.hostMotivation in ['eager', 'open', 'selective'])
            && (isUnset(data, 'cancellationPolicy')
                || data.cancellationPolicy in ['flexible', 'moderate', 'strict'])
            // The read ACL. The host may share with whoever they like; constraints are
            // a size cap (it downloads with every feed document) and no self-lockout.
            && isOptionalList(data, 'allowedViewerIDs', 1000)
            && (isUnset(data, 'allowedViewerIDs')
                || data.allowedViewerIDs.hasAll([data.hostUserID]))
            // Co-hosts: a partner or roommate, not a second owner. Capped small and never the host.
            && isOptionalList(data, 'coHostUserIDs', 5)
            && !data.get('coHostUserIDs', []).hasAny([data.hostUserID])
            && (isUnset(data, 'latitude') || data.latitude is number)
            && (isUnset(data, 'longitude') || data.longitude is number)
            && isOptionalString(data, 'geohash', 12)
            && (isUnset(data, 'deletedAt') || data.deletedAt is timestamp)
            && (isUnset(data, 'createdAt') || data.createdAt is timestamp);
      }

      // Each read clause matches one client query (the feed's `allowedViewerIDs
      // contains me`, own listings, co-host's `coHostUserIDs contains me`). Keep them in
      // sync: a query not provably covered by one clause is rejected wholesale.
      // The keys a co-host may rewrite: the description of the home. Everything
      // else (host, contact, visibility, roster, existence) is pinned because
      // `changedKeys().hasOnly()` rejects any other key.
      function coHostEditableKeys() {
        return ['description', 'hostMotivation', 'sleeping', 'guestPolicy',
                'amenities', 'cancellationPolicy', 'photoURLs',
                'unavailableDateRanges',
                'latitude', 'longitude', 'geohash'];
      }

      // The co-hosts this write adds. Rules can't loop, so a roster change is
      // admitted one addition at a time and checked against the friend graph.
      function addedCoHosts() {
        return request.resource.data.get('coHostUserIDs', [])
                 .removeAll(resource.data.get('coHostUserIDs', []));
      }

      // A co-host keeps read access even if unfriended out of `allowedViewerIDs`;
      // the roster is the grant. This clause makes `coHostUserIDs contains me` legal.
      allow read: if isSignedIn()
          && (resource.data.hostUserID == request.auth.uid
              || request.auth.uid in resource.data.get('allowedViewerIDs', [])
              || request.auth.uid in resource.data.get('coHostUserIDs', []));

      allow create: if isFullMember()
          && request.resource.data.hostUserID == request.auth.uid
          // New listings stamp the server time the feed orders by.
          && request.resource.data.createdAt == request.time
          // A listing is born with no co-hosts, since a roster can't be validated in a loop; add them one update at a time.
          && request.resource.data.get('coHostUserIDs', []).size() == 0
          && isValidListing(request.resource.data);

      // Update re-validates the whole document, so a host can't corrupt a listing into a shape the client silently drops.
      allow update: if isSignedIn()
          // hostUserID is immutable, which stops a co-host taking the host's chair; checked before both branches.
          && request.resource.data.hostUserID == resource.data.hostUserID
          // createdAt is immutable once set; a legacy listing may stamp it once (to request.time).
          && (request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
              || (resource.data.get('createdAt', null) == null
                  && request.resource.data.createdAt == request.time))
          && isValidListing(request.resource.data)
          && (
            // The host. May rewrite anything the validator allows, with at most one
            // co-host addition per write (all a loop-free rule can check). A co-host
            // must be an accepted friend, since they get the street address. Removals
            // are unconstrained; taking a capability back is safe.
            (isOwner(resource.data.hostUserID)
                && (addedCoHosts().size() == 0
                    || (addedCoHosts().size() == 1
                        && areFriends(addedCoHosts()[0], resource.data.hostUserID))))
            ||
            // A co-host. May describe the home (capacity, amenities, availability,
            // photos) and nothing else. Not `allowedViewerIDs` (the client rebuilds it from
            // the saver's friends and would republish the listing to another social
            // graph), nor host details, the roster or `deletedAt`, which would be a
            // soft-delete route around the delete rule.
            (resource.data.get('coHostUserIDs', []).hasAny([request.auth.uid])
                && changedKeys().hasOnly(coHostEditableKeys()))
          );

      // Host only: deleting isn't "managing", and a soft delete is unrecoverable from the client.
      allow delete: if isSignedIn()
          && resource.data.hostUserID == request.auth.uid;

      // -----------------------------------------------------------------------
      // Private listing data, with differing visibility:
      //   - `location`:     exact street address and unrounded coordinates.
      //   - `manual`:       the host's check-in guide.
      //   - `availability`: the calendar with blocked and booked still apart.
      //
      // `location` and `manual` go to the managers plus an accepted guest; the
      // public listing carries only city/state/zip and a coordinate rounded to
      // about a kilometre. `availability` goes to managers only, accepted guests
      // included: acceptance earns the street, not which closed days were
      // bookings, and keeping the halves here is what prevents undoing the public merge.
      // -----------------------------------------------------------------------
      function isValidLocation(data) {
        return data.keys().hasOnly(['street', 'latitude', 'longitude'])
            && data.street is string
            && data.street.size() > 0
            && data.street.size() < 300
            && (isUnset(data, 'latitude') || data.latitude is number)
            && (isUnset(data, 'longitude') || data.longitude is number);
      }
      // Every field the HouseManual model encodes; optional free text with size caps.
      function isValidManual(data) {
        return data.keys().hasOnly([
                 'checkInInstructions', 'wifiNetwork', 'wifiPassword',
                 'keyHandoff', 'houseNotes', 'hostPhone'
               ])
            && isOptionalString(data, 'checkInInstructions', 2000)
            && isOptionalString(data, 'wifiNetwork', 200)
            && isOptionalString(data, 'wifiPassword', 200)
            && isOptionalString(data, 'keyHandoff', 2000)
            && isOptionalString(data, 'houseNotes', 2000)
            && isOptionalString(data, 'hostPhone', 40);
      }
      // The two calendar halves plus the turnover buffer (`bufferHours`). Caps match
      // the former per-field caps. Not range-checked against the calendar, since
      // rules can't loop (the double-booking guard is in the accept transaction).
      // Bounds mirror ListingAvailability.maxBufferHours.
      function isValidAvailability(data) {
        return data.keys().hasOnly(['blockedDateRanges', 'bookedDateRanges', 'bufferHours'])
            && isOptionalList(data, 'blockedDateRanges', 100)
            && isOptionalList(data, 'bookedDateRanges', 100)
            && (isUnset(data, 'bufferHours')
                || (data.bufferHours is int
                    && data.bufferHours >= 0
                    && data.bufferHours <= 168));
      }

      // `bookedDateRanges` was pinned against clients because a Cloud Function owned
      // it. That trigger isn't deployed, so a pinned field was just one nothing
      // writes. The host's app now recomputes it from accepted stays (the client
      // stand-in for `onStayRequestWritten`). No privacy cost: the document is
      // managers-only and a manager can only harm their own calendar.

      // A co-host reads and writes these: a roommate who can't see the address or door code can't let a guest in.
      match /private/{docID} {
        // The accepted-guest branch excludes `availability`, or one accepted stay would make the host's bookings legible.
        allow read: if isSignedIn()
            && (isListingManager(homeID)
                || (docID != 'availability'
                    && exists(/databases/$(database)/documents/homes/$(homeID)/accepted/$(request.auth.uid))));

        allow create, update: if isFullMember()
            && isListingManager(homeID)
            && ((docID == 'location' && isValidLocation(request.resource.data))
                || (docID == 'manual' && isValidManual(request.resource.data))
                || (docID == 'availability'
                    && isValidAvailability(request.resource.data)));

        // `availability` is excluded: the host reconciles it in place, and a stray delete would drop the booked
        // half. `onHomeDeleted` cascades the subcollection as admin, which bypasses these rules.
        allow delete: if isFullMember()
            && isListingManager(homeID)
            && docID != 'availability';
      }

      // -----------------------------------------------------------------------
      // Accepted-guest markers. Existence is the capability (the private location
      // rule checks `accepted/{callerUID}`). A manager writes one on accepting a stay
      // and removes it on decline or cancel; the guest may remove their own.
      // Read, delete and create all ask `isListingManager`, since `isHostSide` lets a
      // co-host answer requests; otherwise a co-host could issue a grant they can't
      // read back or cancel a stay without revoking its address (the cancel batch
      // is atomic and would fail).
      //
      // There is deliberately no `match /{path=**}/accepted/{guestID}`, so clients
      // can't run a collection-group query. The COLLECTION_GROUP index on
      // `accepted.guestUserID` exists for `onUserDeleted`, which uses the Admin SDK.
      // If a client query is ever wanted it needs `resource.data.guestUserID ==
      // request.auth.uid` and nothing looser; `homeID` is unbound under a wildcard,
      // and a bare `isSignedIn()` would expose every host's accepted-guest roster.
      // -----------------------------------------------------------------------
      match /accepted/{guestID} {
        allow read: if isSignedIn()
            && (request.auth.uid == guestID || isListingManager(homeID));

        // The grant is issued alongside a real acceptance, by the manager accepting a
        // request or the guest accepting the host's offer; both are legitimate
        // disclosures. What stops forgery is `getAfter`: it reads post-commit state,
        // so the named request must itself be accepted, for this listing and guest,
        // when the batch settles. A guest can't forge the offer that entitles them,
        // since only the host can create an `offered` request.
        allow create: if isFullMember()
            && (isListingManager(homeID) || request.auth.uid == guestID)
            && request.resource.data.keys().hasOnly(['requestID', 'guestUserID', 'createdAt'])
            && request.resource.data.guestUserID == guestID
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.guestUserID == guestID
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.listingID == homeID;

        // A grant isn't editable in place; revoke and re-issue.
        allow update: if false;

        // Revoking is the safe half: anyone entitled to grant may revoke, and the guest may hand it in.
        allow delete: if isSignedIn()
            && (request.auth.uid == guestID || isListingManager(homeID));
      }
    }

    // -------------------------------------------------------------------------
    // Stay requests
    // Guests create pending requests; hosts accept/decline; guests can cancel.
    // No edits once a request reaches a terminal state.
    // -------------------------------------------------------------------------
    match /stayRequests/{requestID} {
      // The two parties plus any co-host of the listing, which makes the client's
      // `listingID in [...]` inbox query legal. Last so the parties short-circuit first.
      allow read: if isSignedIn()
          && (request.auth.uid == resource.data.guestUserID
              || request.auth.uid == resource.data.hostUserID
              || isListingManager(resource.data.listingID));

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'listingID', 'listingCity', 'listingTitle', 'listingHostName',
               'hostUserID', 'guestUserID', 'checkIn', 'checkOut',
               'guestNote', 'hostNote', 'guestCount', 'arrivalWindow',
               'status', 'initiatedBy', 'completedAt', 'createdAt', 'updatedAt'
             ])
          // Denormalized listing title snapshot (optional), with the listing's 60-char cap.
          && isOptionalString(request.resource.data, 'listingTitle', 60)
          // The other two snapshots (city, host name) were validated nowhere, yet they
          // are interpolated into push bodies and reminder copy, i.e. arbitrary text on
          // the other person's Lock Screen. Capped to match their source fields.
          && isOptionalString(request.resource.data, 'listingCity', 100)
          // 199, not 200: the host-rename branch requires `size() < 200`, so a 200-char name could never be renamed.
          && isOptionalString(request.resource.data, 'listingHostName', 199)
          // A stay can't be born finished.
          && isUnset(request.resource.data, 'completedAt')
          // A stay starts as a guest's request or a host's offer, and the creator must
          // be the party the status says. Pinned together so a host can't fabricate a
          // "request" from a friend and accept it to mint trust stats.
          && (
            // The guest asks. `initiatedBy` is optional so it stays absent on the pre-offers path.
            (request.resource.data.guestUserID == request.auth.uid
                && request.resource.data.status == "pending"
                && (isUnset(request.resource.data, 'initiatedBy')
                    || request.resource.data.initiatedBy == request.auth.uid)
                // A host's note is the host's to write, and only on a reply.
                && isUnset(request.resource.data, 'hostNote')
                // The host's circle policy, enforced on the ask only: a policy governs
                // what a friend may request, not what a host offers. Nothing here fails
                // distinguishably; a stale client sees the same "no longer available"
                // as a lost race, and nobody is told a circle exists.
                && bookingPermitted(request.resource.data.hostUserID, request.auth.uid,
                                    request.resource.data, true))
            ||
            // The host offers. The guest's own fields (note, party size, arrival) are
            // theirs to fill in on accepting; the host mustn't put words in their mouth.
            //
            // Friendship is checked directly, not left to the `allowedViewerIDs` gate:
            // on this path the caller authors that array, so adding any uid and
            // "offering" would land an unsolicited stay in anyone's trip list. The
            // trigger that scrubs rosters runs after the fact and isn't deployed
            // everywhere, so the invariant lives in the rule.
            (request.resource.data.hostUserID == request.auth.uid
                && request.resource.data.status == "offered"
                && request.resource.data.initiatedBy == request.auth.uid
                && request.resource.data.guestUserID != request.auth.uid
                && areFriends(request.resource.data.guestUserID, request.auth.uid)
                && isUnset(request.resource.data, 'guestNote')
                && isUnset(request.resource.data, 'guestCount')
                && isUnset(request.resource.data, 'arrivalWindow')
                && isOptionalString(request.resource.data, 'hostNote', 2000))
          )
          && request.resource.data.hostUserID is string
          && request.resource.data.hostUserID.size() > 0
          && request.resource.data.listingID is string
          && request.resource.data.listingID.size() > 0
          && request.resource.data.checkIn is timestamp
          && request.resource.data.checkOut is timestamp
          && request.resource.data.checkOut > request.resource.data.checkIn
          // Check-in can't be in the past; a one-day grace covers timezone offset for same-day requests.
          && request.resource.data.checkIn > request.time - duration.value(1, 'd')
          // The named host must own the live listing, so a request can't target an arbitrary inbox.
          && listingHasActiveHost(request.resource.data.listingID, request.resource.data.hostUserID)
          // Only someone the listing is shared with may knock: the guest must be in
          // its read ACL, so a leaked listing id can't file requests past the
          // friends-only boundary. The get() is cached with listingHasActiveHost's.
          //
          // Keyed to guestUserID, not the caller, so it holds in both directions: on
          // the host path the caller is always in their own ACL. This clause carries
          // the guest path alone; the host path is gated by areFriends() on the offer
          // branch above. Keep both.
          && request.resource.data.guestUserID in
               get(/databases/$(database)/documents/homes/$(request.resource.data.listingID))
                 .data.get('allowedViewerIDs', [])
          // A block severs this like a thread, between the two parties; on the host path
          // the caller is the host, so checking the caller would be vacuous.
          && !blockedEitherWay(request.resource.data.guestUserID, request.resource.data.hostUserID)
          // Lists order by createdAt; pin it so a request can't backdate itself (the sentinel equals request.time).
          && request.resource.data.createdAt == request.time
          && isOptionalString(request.resource.data, 'guestNote', 2000)
          // Party size, when given, is a positive int up to the listing's capacity.
          && (isUnset(request.resource.data, 'guestCount')
              || (request.resource.data.guestCount is int
                  && request.resource.data.guestCount >= 1
                  && request.resource.data.guestCount <= listingMaxGuests(request.resource.data.listingID)))
          && (isUnset(request.resource.data, 'arrivalWindow')
              || request.resource.data.arrivalWindow in
                   ['flexible', 'morning', 'afternoon', 'evening', 'lateNight']);

      // Status transitions may touch only the status, the acting role's note and
      // updatedAt; everything else is pinned by affectedKeys(), so dates can't be
      // rewritten while accepting or cancelling.
      allow update: if isSignedIn()
          && (
            // Name propagation: a host rewrites only `listingHostName` on their requests,
            // on any status, so past trips show the current name.
            (isOwner(resource.data.hostUserID)
                && changedKeys().hasOnly(['listingHostName'])
                && request.resource.data.listingHostName is string
                && request.resource.data.listingHostName.size() > 0
                && request.resource.data.listingHostName.size() < 200)
            ||
            // Date change on a pending request: the guest only, while pending, and
            // changedKeys() pins everything else (status included), so it can't double
            // as an accept. Date validity mirrors create.
            (isOwner(resource.data.guestUserID)
                && resource.data.status == "pending"
                && changedKeys().hasOnly(['checkIn', 'checkOut', 'updatedAt'])
                && request.resource.data.updatedAt == request.time
                && request.resource.data.checkIn is timestamp
                && request.resource.data.checkOut is timestamp
                && request.resource.data.checkOut > request.resource.data.checkIn
                && request.resource.data.checkIn > request.time - duration.value(1, 'd')
                // A date change could dodge the notice rule (ask far out, walk it back),
                // so the same bound applies. It spends no new slot; the arrival window is pinned.
                && bookingPermitted(resource.data.hostUserID, request.auth.uid,
                                    request.resource.data, false))
            ||
            // Status transitions: no edits once the request is terminal.
            (resource.data.status in ["pending", "offered", "accepted"]
                && request.resource.data.updatedAt == request.time
                && (
                  // Host declines a pending request. Acceptance isn't a client write via
                  // this branch; the callable's admin transaction is the race-free guard.
                  (isHostSide(resource.data)
                      && resource.data.status == "pending"
                      && request.resource.data.status == "declined"
                      && changedKeys().hasOnly(['status', 'hostNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Host accepts a pending request. The callable was the only way (an
                  // admin could read every accepted stay) but isn't deployed, so a
                  // client transaction over `private/availability` serializes
                  // instead: two devices contend on one document and the loser
                  // retries. Same guarantee for one host with two devices; weaker
                  // against a modified client, which rules can't check without
                  // looping. Narrower than the callable: pending only, host side only
                  // (a guest accepting an offer can't read the calendar).
                  (isHostSide(resource.data)
                      && resource.data.status == "pending"
                      && request.resource.data.status == "accepted"
                      && changedKeys().hasOnly(['status', 'hostNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Guest declines a host's offer. Their note goes in guestNote, since
                  // hostNote belongs to the host and overwriting it would edit their words.
                  (isOwner(resource.data.guestUserID)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "declined"
                      && changedKeys().hasOnly(['status', 'guestNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'guestNote', 2000))
                  ||
                  // Guest accepts a host's offer. Client-side since the callable isn't
                  // deployed. The guest can't read the private calendar, so there's no
                  // serialized overlap check; the host's booked-range reconciler is the
                  // double-booking guard (weaker, but all a guest can do without a
                  // server). The guest adds only their own note; hostNote is the host's.
                  (isOwner(resource.data.guestUserID)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "accepted"
                      && changedKeys().hasOnly(['status', 'guestNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'guestNote', 2000))
                  ||
                  // Host withdraws an unanswered offer: cancelled, not declined, so it
                  // doesn't read as the guest's refusal. `cancelledBy` stays the listing's
                  // host even when a co-host retracts; it records which side backed out.
                  (isHostSide(resource.data)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'hostNote', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.hostUserID
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Guest cancels a pending or accepted request. `cancelledBy` records
                  // which side backed out (the push trigger needs it) and is pinned to
                  // the caller so neither party can pin blame on the other.
                  (isOwner(resource.data.guestUserID)
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.guestUserID)
                  ||
                  // Host calls off an accepted stay they can't honor. Cancelled, not
                  // declined, so trip rows read the same either way; the note gives the guest a why.
                  (isHostSide(resource.data)
                      && resource.data.status == "accepted"
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'hostNote', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.hostUserID
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Either party closes out an accepted stay that has begun. Completion
                  // unlocks reviews and trustStats, so the checkIn bound stops a host
                  // farming completed stays by "finishing" a booking a year out.
                  // completedAt is write-once.
                  (resource.data.status == "accepted"
                      && request.resource.data.status == "completed"
                      && (isHostSide(resource.data) || isOwner(resource.data.guestUserID))
                      && changedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
                      && request.resource.data.completedAt == request.time
                      && request.time >= resource.data.checkIn)
                ))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Messages
    // participants is always [smaller_uid, larger_uid], keeping pairs canonical for the (participants, timestamp) index.
    // -------------------------------------------------------------------------
    match /messages/{messageID} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(
               ['id', 'senderUserID', 'text', 'timestamp', 'participants', 'event']
             )
          && validMessageEvent(request.resource.data)
          && request.resource.data.senderUserID == request.auth.uid
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && request.resource.data.participants[0] < request.resource.data.participants[1]
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 5000
          && request.resource.data.timestamp == request.time
          // Reject if either party blocked the other, so a block can't be bypassed by a direct write.
          && !blockedEitherWay(
               request.auth.uid,
               request.resource.data.participants[0] == request.auth.uid
                 ? request.resource.data.participants[1]
                 : request.resource.data.participants[0]
             )
          // The friend graph gates messaging. Sends were open to any member the
          // recipient hadn't blocked, so a stranger knowing a uid could put text on
          // their lock screen; an unsolicited write is the friendship's decision.
          && areFriends(
               request.auth.uid,
               request.resource.data.participants[0] == request.auth.uid
                 ? request.resource.data.participants[1]
                 : request.resource.data.participants[0]
             )
          // Enforce the send rate in the write path: the same commit must advance the
          // sender's rateLimits counter, capped below at MESSAGE_RATE_LIMIT per window.
          && rateCounterAdvanced(request.auth.uid);

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Conversations: the denormalized per-thread summary behind the list and unread
    // badge. `onMessageCreated` owns lastMessage, updatedAt and unread increments
    // (admin bypasses these rules). Clients may only clear their own unread count
    // or toggle their own `mutedBy` membership; all else is pinned.
    // conversationID = sorted participants joined by "_".
    // -------------------------------------------------------------------------
    match /conversations/{conversationID} {
      // The participant who isn't the caller; reads resource.data, so valid only where the doc exists.
      function conversationOther() {
        return resource.data.participants[0] == request.auth.uid
            ? resource.data.participants[1]
            : resource.data.participants[0];
      }

      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      // Only the trigger (admin) creates summaries.
      allow create: if false;

      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants
          && (
            // Mark read: zero only my own unread count.
            (changedKeys().hasOnly(['unreadCounts'])
                && request.resource.data.unreadCounts.get(request.auth.uid, 0) == 0
                && request.resource.data.unreadCounts.get(conversationOther(), 0)
                     == resource.data.unreadCounts.get(conversationOther(), 0))
            ||
            // Mute / unmute: add or remove only myself from mutedBy.
            (changedKeys().hasOnly(['mutedBy'])
                && request.resource.data.mutedBy is list
                && request.resource.data.mutedBy.hasOnly(resource.data.participants)
                && (conversationOther() in request.resource.data.mutedBy)
                     == (conversationOther() in resource.data.get('mutedBy', [])))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Rate-limit counters: one per user, written only in the commit of the message
    // it gates (see rateCounterAdvanced). A fixed window: `count` messages since
    // `windowStart`. The rules refuse an increment past the cap and reopening before
    // the window expires, so a modified client can't grant itself headroom.
    // -------------------------------------------------------------------------
    match /rateLimits/{userID} {
      // Window length and cap; keep in sync with the client's MessageStore.sendRateLimit / sendRateWindow.
      function windowSeconds() { return 60; }
      function messageCap() { return 30; }

      allow read: if isSignedIn() && isOwner(userID);

      // First message ever (or after a reset): a fresh window at request.time with one message.
      allow create: if isFullMember()
          && isOwner(userID)
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;

      allow update: if isFullMember()
          && isOwner(userID)
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.count is int
          && (
            // The previous window elapsed: open a new one at request.time.
            (request.time >= resource.data.windowStart + duration.value(windowSeconds(), 's')
                && request.resource.data.windowStart == request.time
                && request.resource.data.count == 1)
            ||
            // Inside the open window: increment by one up to the cap; windowStart is pinned so it can't be slid forward.
            (request.resource.data.windowStart == resource.data.windowStart
                && request.time < resource.data.windowStart + duration.value(windowSeconds(), 's')
                && request.resource.data.count == resource.data.count + 1
                && request.resource.data.count <= messageCap())
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Stay counters: the frequency half of a circle's booking policy. Document id
    // is "{hostUID}_{guestUID}", pinned to the id fields below.
    //
    // Rules can't query "how often has this person booked me", so, as with message
    // rate limits, the guest advances this counter in the request's commit, the
    // stay request rule requires it via getAfter(), and the cap lives here. Cap and
    // window come from the host's circle documents, which the guest can't write.
    //
    // A slot is spent on create and not refunded on decline or cancel (that would
    // need a server recount); the throttle is on how often someone asks.
    // -------------------------------------------------------------------------
    match /stayCounters/{counterID} {
      function capCount(data) { return pairCapCount(data.hostUserID, data.guestUserID); }
      function windowDays(data) { return pairCapPeriodDays(data.hostUserID, data.guestUserID); }

      // Both parties read it: the guest to know when the window rolls, the host to see what a circle is doing.
      allow read: if isSignedIn()
          && (isOwner(resource.data.guestUserID) || isOwner(resource.data.hostUserID));

      // First request this guest sent this host: a fresh window with one request.
      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(['hostUserID', 'guestUserID', 'windowStart', 'count'])
          && request.resource.data.hostUserID is string
          && request.resource.data.guestUserID is string
          && counterID == request.resource.data.hostUserID + '_' + request.resource.data.guestUserID
          && isOwner(request.resource.data.guestUserID)
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;

      allow update: if isFullMember()
          && request.resource.data.keys().hasOnly(['hostUserID', 'guestUserID', 'windowStart', 'count'])
          && request.resource.data.hostUserID == resource.data.hostUserID
          && request.resource.data.guestUserID == resource.data.guestUserID
          && isOwner(resource.data.guestUserID)
          && request.resource.data.count is int
          && (
            // The window elapsed, or the host has no cap: open a fresh one.
            ((windowDays(resource.data) == 0
              || request.time >= resource.data.windowStart + duration.value(windowDays(resource.data), 'd'))
                && request.resource.data.windowStart == request.time
                && request.resource.data.count == 1)
            ||
            // Inside the open window: increment by one up to the cap; windowStart is pinned, as in rateLimits.
            (request.resource.data.windowStart == resource.data.windowStart
                && request.resource.data.count == resource.data.count + 1
                && (capCount(resource.data) == 0
                    || request.resource.data.count <= capCount(resource.data)))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Friend edges: bidirectional connections, edgeID = "{smallerUID}_{largerUID}".
    // -------------------------------------------------------------------------
    match /friendEdges/{edgeID} {
      allow read: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB);

      // Send a friend request (create a pending edge). The key allowlist blocks extra fields.
      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(
               ['userA', 'userB', 'status', 'initiator', 'createdAt', 'updatedAt']
             )
          && request.resource.data.initiator == request.auth.uid
          && (request.resource.data.userA == request.auth.uid
              || request.resource.data.userB == request.auth.uid)
          && request.resource.data.status == "pending"
          && request.resource.data.userA is string
          && request.resource.data.userB is string
          && request.resource.data.userA < request.resource.data.userB
          && request.resource.data.userA != request.resource.data.userB
          // edgeID must match the canonical "{userA}_{userB}" form
          && edgeID == request.resource.data.userA + "_" + request.resource.data.userB
          // A block stops friend requests too; otherwise a blocked user could re-send forever after a decline-delete.
          && !blockedEitherWay(request.resource.data.userA, request.resource.data.userB);

      // Accept a pending request (non-initiator only).
      allow update: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB)
          && resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.auth.uid != resource.data.initiator
          // The accept may move only the status and its timestamp. hasOnly() bounds
          // what may be added (equality pins alone left extra fields and padding open),
          // and pins userA/userB/initiator/createdAt by omission.
          && changedKeys().hasOnly(['status', 'updatedAt']);

      // Either party may delete (decline, cancel or unfriend).
      allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB);
    }

    // -------------------------------------------------------------------------
    // Reviews: post-stay, two-way, public. The document id is
    // "{stayRequestID}_{authorUID}", making one review per person per stay a
    // property of the path; only the author may rewrite it. A review needs a
    // finished stay, by one of its participants, about the other, all read off the
    // stay request with an elevated get().
    // -------------------------------------------------------------------------
    match /reviews/{reviewID} {
      function stayPath(requestID) {
        return /databases/$(database)/documents/stayRequests/$(requestID);
      }
      function stay(requestID) {
        return get(stayPath(requestID)).data;
      }

      function isValidReviewBody(data) {
        return data.rating is int
            && data.rating >= 1
            && data.rating <= 5
            && isOptionalString(data, 'publicComment', 2000);
      }

      // Public reputation record, readable by full members (not anonymous guests, who could enumerate).
      allow read: if isFullMember();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'stayRequestID', 'listingID', 'authorUserID',
               'subjectUserID', 'role', 'rating', 'publicComment',
               'createdAt', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll([
               'stayRequestID', 'listingID', 'authorUserID', 'subjectUserID', 'role', 'rating'
             ])
          && request.resource.data.authorUserID == request.auth.uid
          // The id pins one review per (stay, author).
          && reviewID == request.resource.data.stayRequestID + '_' + request.auth.uid
          && request.resource.data.get('id', reviewID) == reviewID
          && isValidReviewBody(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(stayPath(request.resource.data.stayRequestID))
          // Only a finished stay may be reviewed.
          && stay(request.resource.data.stayRequestID).status == 'completed'
          && stay(request.resource.data.stayRequestID).listingID == request.resource.data.listingID
          // ...by one of its participants, about the other, with the matching role.
          && (
            (request.auth.uid == stay(request.resource.data.stayRequestID).guestUserID
                && request.resource.data.subjectUserID == stay(request.resource.data.stayRequestID).hostUserID
                && request.resource.data.role == 'guestReviewingHost')
            ||
            (request.auth.uid == stay(request.resource.data.stayRequestID).hostUserID
                && request.resource.data.subjectUserID == stay(request.resource.data.stayRequestID).guestUserID
                && request.resource.data.role == 'hostReviewingGuest')
          );

      // The author may revise; who reviewed whom about which stay is pinned by affectedKeys().
      allow update: if isSignedIn()
          && isOwner(resource.data.authorUserID)
          && changedKeys().hasOnly(['rating', 'publicComment', 'updatedAt'])
          && isValidReviewBody(request.resource.data)
          && request.resource.data.updatedAt == request.time;

      // A review is a record, not a draft. Removal is a moderation action.
      allow delete: if false;

      // The private feedback channel: what the reviewer would say to the reviewed's face. Readable by exactly those two.
      match /private/{docID} {
        function reviewPath() {
          return /databases/$(database)/documents/reviews/$(reviewID);
        }
        function review() {
          return get(reviewPath()).data;
        }

        allow read: if isSignedIn()
            && docID == 'feedback'
            && exists(reviewPath())
            && (isOwner(review().authorUserID) || isOwner(review().subjectUserID));

        allow create, update: if isFullMember()
            && docID == 'feedback'
            && exists(reviewPath())
            && isOwner(review().authorUserID)
            && request.resource.data.keys().hasOnly(['text'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;

        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // References: a friend vouching for a friend, independent of any stay. The id
    // is "{subjectUID}_{authorUID}", so one friend writes at most one reference
    // for another, and `areFriends` stops strangers vouching. Either party may
    // delete: the author changed their mind, or the subject doesn't want it on their profile.
    // -------------------------------------------------------------------------
    match /references/{referenceID} {
      // Public reputation record, full members only (see the reviews read).
      allow read: if isFullMember();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'authorUserID', 'subjectUserID', 'text', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll(['authorUserID', 'subjectUserID', 'text'])
          && request.resource.data.authorUserID == request.auth.uid
          && referenceID == request.resource.data.subjectUserID + '_' + request.auth.uid
          && request.resource.data.get('id', referenceID) == referenceID
          && request.resource.data.subjectUserID is string
          && request.resource.data.subjectUserID != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Vouching is a friendship-gated act.
          && areFriends(request.auth.uid, request.resource.data.subjectUserID)
          // A block severs this like a thread.
          && !blockedEitherWay(request.auth.uid, request.resource.data.subjectUserID);

      allow update: if isSignedIn()
          && isOwner(resource.data.authorUserID)
          && changedKeys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn()
          && (isOwner(resource.data.authorUserID) || isOwner(resource.data.subjectUserID));
    }

    // -------------------------------------------------------------------------
    // Reports: the moderation inbox. Written by any full member and by the
    // moderation triggers (admin bypasses these rules); read and triaged only by a
    // moderator with the `admin` claim. Reporters can't read their report back.
    // Triage: new → reviewing → actioned | dismissed; the report itself is immutable.
    // -------------------------------------------------------------------------
    match /reports/{reportID} {
      allow read: if isAdmin();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'reporterUserID', 'targetType', 'targetID', 'reason',
               'status', 'source', 'createdAt'
             ])
          && request.resource.data.reporterUserID == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() < 2000
          && request.resource.data.targetType in ["user", "listing", "message"]
          // What is reported is bounded like other client strings; unbounded here would be abuse in a write-only inbox.
          && request.resource.data.targetID is string
          && request.resource.data.targetID.size() > 0
          && request.resource.data.targetID.size() < 200
          // A fresh report enters triage at the top, filed by a person (`source: "auto"` is for the triggers).
          && (isUnset(request.resource.data, 'status') || request.resource.data.status == 'new')
          && (isUnset(request.resource.data, 'source') || request.resource.data.source == 'user')
          // The console orders by createdAt, so a report can't backdate itself out of sight.
          && (isUnset(request.resource.data, 'createdAt')
              || request.resource.data.createdAt == request.time);

      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'moderatorNote', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['new', 'reviewing', 'actioned', 'dismissed']
          && isOptionalString(request.resource.data, 'moderatorNote', 2000)
          && request.resource.data.get('reviewedBy', request.auth.uid) == request.auth.uid;

      allow delete: if false;
    }

  }
}
