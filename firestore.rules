rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Listings: any signed-in user can read; only the host can write their own
    match /homes/{homeID} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.hostUserID == request.auth.uid;
      allow update, delete: if isSignedIn()
          && resource.data.hostUserID == request.auth.uid;
    }

    // Messages: flat collection, participants array embedded on each document.
    // The query filters by participants so Firestore can statically verify access.
    match /messages/{messageID} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
          && request.resource.data.senderUserID == request.auth.uid
          && request.auth.uid in request.resource.data.participants;

      // Messages are immutable once sent
      allow update, delete: if false;
    }
  }
}
