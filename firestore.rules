rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Listings: any signed-in user can read; only the host can write their own
    match /homes/{homeID} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.hostUserID == request.auth.uid
          && request.resource.data.hostName is string
          && request.resource.data.hostName.size() > 0
          && request.resource.data.hostName.size() < 200;
      allow update, delete: if isSignedIn()
          && resource.data.hostUserID == request.auth.uid;
    }

    // Messages: user-to-user, not tied to any listing.
    // participants is always sorted [userA, userB], both signed-in user IDs.
    match /messages/{messageID} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(
               ['id', 'senderUserID', 'text', 'timestamp', 'participants']
             )
          && request.resource.data.senderUserID == request.auth.uid
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && request.resource.data.participants[0] < request.resource.data.participants[1]
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 5000
          && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
