// Deploy with: firebase deploy --only firestore:rules,firestore:indexes
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return request.auth.uid == userID;
    }

    // A moderator. The `admin` custom claim is minted out of band by
    // `scripts/set_admin_claim.js` (Admin SDK) and never by the app, so it cannot
    // be self-assigned. Reads the claim through map.get() so an account without
    // the claim evaluates to false instead of erroring on a missing key.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // True when `a` and `b` have an accepted friend edge. The edge id is its two
    // participants sorted alphabetically, and rules cannot sort, so both orders
    // are probed; `||` short-circuits on the hit.
    function areFriends(a, b) {
      return (exists(/databases/$(database)/documents/friendEdges/$(a + '_' + b))
              && get(/databases/$(database)/documents/friendEdges/$(a + '_' + b)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendEdges/$(b + '_' + a))
              && get(/databases/$(database)/documents/friendEdges/$(b + '_' + a)).data.status == 'accepted');
    }

    // Anonymous "guest" accounts may browse (read) but must not write. The UI
    // already restricts guests; this makes it a real security boundary rather
    // than a client-side convention.
    function isFullMember() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // True when `ownerID`'s private profile lists `otherID` as blocked.
    // get()/exists() run with elevated privilege, so this reads the owner-only
    // private doc that clients cannot. Missing doc or field is treated as "not
    // blocked" via the default on get().
    function hasBlocked(ownerID, otherID) {
      return exists(/databases/$(database)/documents/users/$(ownerID)/private/profile)
          && get(/databases/$(database)/documents/users/$(ownerID)/private/profile)
               .data.get('blockedUserIDs', []).hasAny([otherID]);
    }

    // A block severs the thread both ways (S11). Checking only the recipient's
    // list stopped a blocked sender but still let the blocker write to the
    // person they blocked: the UI hides that thread, but a direct Firestore
    // write bypassed the UI. `||` short-circuits, so the common case costs the
    // same single document read it did before.
    function blockedEitherWay(userA, userB) {
      return hasBlocked(userA, userB) || hasBlocked(userB, userA);
    }

    // True when the caller hosts the listing. get() runs with elevated privilege,
    // so this works from a subcollection rule that cannot read the parent doc
    // through `resource`. Denies (rather than errors) when the listing is gone.
    //
    // This is the *identity* question — who owns the listing — and is deliberately
    // distinct from `isListingManager` below. A co-host manages a listing; they do
    // not become its host. Every place that decides who receives a stay request,
    // who may grant a guest the street address, or who may delete the listing
    // outright keeps asking this one.
    function isListingHost(homeID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == request.auth.uid;
    }

    // True when the caller may *manage* the listing: its host, or one of the
    // co-hosts the host has named (feature 14). This is the question the listing's
    // own description and its progressively-disclosed subdocuments ask, because a
    // roommate who cannot read the street address cannot let a guest in.
    function isListingManager(homeID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && (get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == request.auth.uid
              || get(/databases/$(database)/documents/homes/$(homeID))
                   .data.get('coHostUserIDs', []).hasAny([request.auth.uid]));
    }

    // True when the caller may answer a stay request with the host's authority:
    // the host named on the request, or a co-host of the listing it targets
    // (feature 14).
    //
    // Co-hosts were deliberately excluded from stay requests when co-hosting
    // landed, on the reasoning that managing a listing is not becoming its host.
    // That left a co-host able to read the street address and block dates on the
    // calendar while blind to the bookings filling it, which is the half of the
    // job that made the other half incoherent. A co-host now answers requests for
    // the listings they manage; naming one is the act of delegating that.
    //
    // `isOwner` is checked first so the common path (the host themselves) costs
    // no extra document read — rules short-circuit, and only the co-host branch
    // pays for the get() inside isListingManager.
    //
    // Takes the document rather than the listing id because both callers already
    // hold `resource.data`, and the owner check needs `hostUserID` off the same
    // map. Safe on a create, where `resource` is null: the update rule is not
    // reached, and rules-tests/requests.test.mjs covers that path.
    function isHostSide(data) {
      return isOwner(data.hostUserID) || isListingManager(data.listingID);
    }

    // True when `homeID` is a live listing (exists, not soft-deleted) whose host
    // is exactly `claimedHostID`. Used to stop a guest from fabricating a stay
    // request that names an arbitrary victim as host or targets a dead listing
    // (S8). get() reads with elevated privilege, so it works even for a
    // friends-only listing the guest can legitimately see.
    function listingHasActiveHost(homeID, claimedHostID) {
      return exists(/databases/$(database)/documents/homes/$(homeID))
          && get(/databases/$(database)/documents/homes/$(homeID)).data.hostUserID == claimedHostID
          && get(/databases/$(database)/documents/homes/$(homeID)).data.get('deletedAt', null) == null;
    }

    // The listing's advertised guest capacity, used to bound a stay request's
    // party size (feature 20). Duplicate get()s in one evaluation are cached by
    // the rules engine, so this shares the read listingHasActiveHost already did.
    function listingMaxGuests(homeID) {
      return get(/databases/$(database)/documents/homes/$(homeID)).data.guestPolicy.maxGuests;
    }

    // -------------------------------------------------------------------------
    // Circles — friend-grouped booking rules.
    //
    // A host sorts their friends into named circles and hangs a booking policy
    // off each one. The whole point of the feature is that a restricted friend
    // is never told: there is no decline, no error, and nothing on a guest's
    // screen that distinguishes a rule from a busy week. That means these rules
    // are the *only* enforcement that counts — the client hides what it must not
    // offer, but hiding is not refusing, and a modified client is exactly the
    // caller a host restricting someone has in mind.
    //
    // Resolution order, matched exactly by CirclePolicyResolver in the Swift
    // client: per-friend override, then the circle the friend is filed under,
    // then the Default circle. It always terminates, because Default lives at a
    // fixed document id. Rules cannot query, so "which circle is the default
    // one" could never have been a field to search for; it has to be a path.
    //
    // A host who has no circles at all — nobody has run the migration, and they
    // have not opened the app since Circles shipped — restricts nothing, which
    // is precisely the behaviour they had before. That is the absence of
    // configuration, not a special case for Default: once the documents exist,
    // Default is read like any other circle.
    //
    // See docs/internal/CIRCLES.md.
    // -------------------------------------------------------------------------

    function defaultCircleID() { return 'default'; }

    // Mirrors ArrivalWindow in the Swift client and the whitelist the stay
    // request create rule applies to `arrivalWindow`; rules-tests/mirrors.test.mjs
    // asserts all three still agree.
    function arrivalOptions() {
      return ['flexible', 'morning', 'afternoon', 'evening', 'lateNight'];
    }

    function circlePath(hostID, circleID) {
      return /databases/$(database)/documents/users/$(hostID)/circles/$(circleID);
    }

    function membershipPath(hostID, friendID) {
      return /databases/$(database)/documents/users/$(hostID)/circleMembers/$(friendID);
    }

    // The shape of a policy, wherever it is stored: on a circle, as a per-friend
    // override, or as the resolved projection a guest reads. Bounds mirror
    // BookingPolicy / StayFrequencyCap in Circle.swift.
    function isValidBookingPolicy(policy) {
      return policy is map
          && policy.keys().hasOnly(['allowedArrivalOptions', 'minNoticeHours', 'maxStaysPerPeriod'])
          && policy.keys().hasAll(['allowedArrivalOptions', 'minNoticeHours'])
          && policy.allowedArrivalOptions is list
          && policy.allowedArrivalOptions.size() > 0
          && policy.allowedArrivalOptions.size() <= 5
          && policy.allowedArrivalOptions.hasOnly(arrivalOptions())
          && policy.minNoticeHours is int
          && policy.minNoticeHours >= 0
          && policy.minNoticeHours <= 8760
          // Absent means uncapped. There is no sentinel count standing in for
          // "unlimited", so a cleared cap leaves no number behind to misread.
          && (policy.get('maxStaysPerPeriod', null) == null
              || (policy.maxStaysPerPeriod is map
                  && policy.maxStaysPerPeriod.keys().hasOnly(['count', 'periodDays'])
                  && policy.maxStaysPerPeriod.count is int
                  && policy.maxStaysPerPeriod.count >= 1
                  && policy.maxStaysPerPeriod.count <= 100
                  && policy.maxStaysPerPeriod.periodDays is int
                  && policy.maxStaysPerPeriod.periodDays >= 1
                  && policy.maxStaysPerPeriod.periodDays <= 3650));
    }

    // The resolution below is written as a chain of functions that pass the
    // document they just read down as an argument, rather than as helpers that
    // each re-read it. Rules have no local bindings, so a `policy(host, friend)`
    // helper called from four places is four full re-resolutions — and the first
    // draft of this blew the engine's 1000-expression budget on an ordinary
    // booking. Passing the map is the binding.

    // 0 for anything that isn't a plain int, so a malformed policy written out
    // of band degrades to "no minimum" rather than wedging a host's bookings.
    function noticeHours(p) {
      return p.get('minNoticeHours', 0) is int ? p.get('minNoticeHours', 0) : 0;
    }

    // 0 means uncapped — an absent cap, and also a malformed one.
    function capCountOf(p) {
      return p.get('maxStaysPerPeriod', null) == null
           ? 0
           : (p.maxStaysPerPeriod.get('count', 0) is int ? p.maxStaysPerPeriod.get('count', 0) : 0);
    }

    function capPeriodDaysOf(p) {
      return p.get('maxStaysPerPeriod', null) == null
           ? 0
           : (p.maxStaysPerPeriod.get('periodDays', 0) is int ? p.maxStaysPerPeriod.get('periodDays', 0) : 0);
    }

    // Whether policy `p` admits this booking.
    //
    // An absent arrivalWindow is read as 'flexible' rather than waved through:
    // the field is optional on the document, so treating "unset" as "unchecked"
    // would leave the whole arrival restriction one omitted key away from being
    // nothing at all.
    //
    // checkIn is a local start-of-day, and the client rounds the same horizon up
    // to a whole day before greying cells out (BookingPolicy.earliestCheckIn),
    // so the two agree on which day is the first bookable one.
    //
    // `needsSlot` is false when the write is an edit to a request that already
    // spent one: moving the dates on a pending request is the same ask, not
    // another.
    function policyPermits(p, hostID, friendID, data, needsSlot) {
      return data.get('arrivalWindow', 'flexible')
               in p.get('allowedArrivalOptions', arrivalOptions())
          // Zero is skipped rather than compared against: checkIn is a
          // start-of-day, so `checkIn >= request.time` would reject the
          // same-day request the app has always allowed, and "no minimum
          // notice" must mean exactly the behaviour a host had before Circles.
          && (noticeHours(p) == 0
              || data.checkIn >= request.time + duration.value(noticeHours(p), 'h'))
          && (!needsSlot
              || capCountOf(p) == 0
              || stayCounterAdvanced(hostID, friendID));
    }

    function circleHasPolicy(hostID, circleID) {
      return exists(circlePath(hostID, circleID))
          && 'policy' in get(circlePath(hostID, circleID)).data;
    }

    // The circle named, falling back to Default when it has been deleted, and
    // to no restriction at all when the host has no circles — the state of a
    // host who has not opened the app since Circles shipped.
    function circlePermits(hostID, circleID, friendID, data, needsSlot) {
      return circleHasPolicy(hostID, circleID)
           ? policyPermits(get(circlePath(hostID, circleID)).data.policy, hostID, friendID, data, needsSlot)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? policyPermits(get(circlePath(hostID, defaultCircleID())).data.policy,
                              hostID, friendID, data, needsSlot)
              : true);
    }

    // A per-friend override supersedes the circle, which is the entire meaning
    // of an override.
    function membershipPermits(hostID, member, friendID, data, needsSlot) {
      return member.get('overridePolicy', null) != null
           ? policyPermits(member.overridePolicy, hostID, friendID, data, needsSlot)
           : circlePermits(hostID, member.get('circleID', defaultCircleID()), friendID, data, needsSlot);
    }

    // The entry point: does `hostID`'s Circles configuration admit this booking
    // from `friendID`? A friend with no membership document is governed by
    // Default, which is the window between a friend request being accepted and
    // the host's client filing them.
    function bookingPermitted(hostID, friendID, data, needsSlot) {
      return exists(membershipPath(hostID, friendID))
           ? membershipPermits(hostID, get(membershipPath(hostID, friendID)).data, friendID, data, needsSlot)
           : circlePermits(hostID, defaultCircleID(), friendID, data, needsSlot);
    }

    // The cap and window governing a pair, for the counter's own rules. Same
    // chain, resolving to numbers instead of a verdict; 0 means uncapped.
    function pairCapCount(hostID, friendID) {
      return exists(membershipPath(hostID, friendID))
           ? membershipCapCount(hostID, get(membershipPath(hostID, friendID)).data)
           : circleCapCount(hostID, defaultCircleID());
    }

    function membershipCapCount(hostID, member) {
      return member.get('overridePolicy', null) != null
           ? capCountOf(member.overridePolicy)
           : circleCapCount(hostID, member.get('circleID', defaultCircleID()));
    }

    function circleCapCount(hostID, circleID) {
      return circleHasPolicy(hostID, circleID)
           ? capCountOf(get(circlePath(hostID, circleID)).data.policy)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? capCountOf(get(circlePath(hostID, defaultCircleID())).data.policy)
              : 0);
    }

    function pairCapPeriodDays(hostID, friendID) {
      return exists(membershipPath(hostID, friendID))
           ? membershipCapPeriodDays(hostID, get(membershipPath(hostID, friendID)).data)
           : circleCapPeriodDays(hostID, defaultCircleID());
    }

    function membershipCapPeriodDays(hostID, member) {
      return member.get('overridePolicy', null) != null
           ? capPeriodDaysOf(member.overridePolicy)
           : circleCapPeriodDays(hostID, member.get('circleID', defaultCircleID()));
    }

    function circleCapPeriodDays(hostID, circleID) {
      return circleHasPolicy(hostID, circleID)
           ? capPeriodDaysOf(get(circlePath(hostID, circleID)).data.policy)
           : (circleHasPolicy(hostID, defaultCircleID())
              ? capPeriodDaysOf(get(circlePath(hostID, defaultCircleID())).data.policy)
              : 0);
    }

    function stayCounterPath(hostID, guestID) {
      return /databases/$(database)/documents/stayCounters/$(hostID + '_' + guestID);
    }

    // The frequency cap, enforced the only way a query-less rule can enforce a
    // rate: the guest advances a counter in the same commit as the request, this
    // requires the advance to have happened, and the counter's own rules cap it.
    // Deliberately identical in shape to rateCounterAdvanced() below, including
    // its caveat — a batch of creates paired with one increment shares a slot,
    // and App Check is the primary control against a hand-rolled client.
    function stayCounterAdvanced(hostID, guestID) {
      return (getAfter(stayCounterPath(hostID, guestID)).data.windowStart == request.time
              && getAfter(stayCounterPath(hostID, guestID)).data.count == 1)
          || (exists(stayCounterPath(hostID, guestID))
              && getAfter(stayCounterPath(hostID, guestID)).data.count
                 == get(stayCounterPath(hostID, guestID)).data.count + 1);
    }

    // The keys an update actually touches. Anything absent from the caller's
    // allowlist is thereby pinned to its existing value.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when this write also validly advances the caller's rateLimits counter
    // in the same commit — either opening a fresh window (count resets to 1 at
    // request.time) or incrementing an already-open one. getAfter() reads the
    // post-commit state, so tying a message create to it forces every send to
    // consume a slot the rateLimits rules cap at MESSAGE_RATE_LIMIT per window.
    // Caveat: a batch of N message creates paired with a single counter
    // increment all see the same getAfter() and so share one slot; rules cannot
    // count sibling writes. App Check is the primary control against such a
    // hand-rolled client (see the deployment checklist); this is defense in depth
    // against the naive send-in-a-loop that the audit's S4 describes.
    function rateCounterAdvanced(uid) {
      return (getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.windowStart == request.time
              && getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.count == 1)
          || (exists(/databases/$(database)/documents/rateLimits/$(uid))
              && getAfter(/databases/$(database)/documents/rateLimits/$(uid)).data.count
                 == get(/databases/$(database)/documents/rateLimits/$(uid)).data.count + 1);
    }

    // Optional-field helpers. The Swift Firestore encoder omits nil optionals
    // rather than writing null, but seed and admin writes do use null, so both
    // absent and null count as "unset". These take the field name as a string
    // and read it with map.get(), because indexing a map by a variable key is
    // not part of the rules language.
    function isUnset(data, field) {
      return data.get(field, null) == null;
    }

    function isOptionalString(data, field, maxLength) {
      return isUnset(data, field)
          || (data.get(field, '') is string
              && data.get(field, '').size() <= maxLength);
    }

    function isOptionalList(data, field, maxCount) {
      return isUnset(data, field)
          || (data.get(field, []) is list
              && data.get(field, []).size() <= maxCount);
    }

    // A message may carry an optional structured stay event (item 29). Absent is
    // fine (an ordinary chat message); when present it must be a well-formed map
    // with a known kind, so a modified client cannot smuggle arbitrary data onto
    // a message the recipient's UI will render as a trusted system card.
    // The kind list mirrors StayEvent.Kind in MessageStore.swift; a kind the
    // client sends but this list omits makes the courtesy note silently fail.
    function validMessageEvent(data) {
      return isUnset(data, 'event')
          || (data.event is map
              && data.event.keys().hasOnly(['kind', 'dateRange', 'note'])
              && data.event.kind is string
              && data.event.kind in ['requested', 'offered', 'accepted', 'declined', 'cancelled', 'modified']
              && data.event.dateRange is string
              && data.event.dateRange.size() > 0
              && data.event.dateRange.size() < 200
              && isOptionalString(data.event, 'note', 2000));
    }

    // -------------------------------------------------------------------------
    // Users
    // The user document is a PUBLIC projection (displayName + timestamps +
    // trustStats) that any full member may read for name display in
    // chat/listings and for the reputation chips on a listing card. PII and
    // safety-sensitive data (email, fcmToken, blockedUserIDs, savedListingIDs,
    // emergencyContact) live in the owner-only `private/profile` subdocument below
    // and are never world-readable. Only the owner can create/update. Deletes are
    // forbidden on the client; account deletion is handled by a Cloud Function
    // cascade.
    // -------------------------------------------------------------------------
    match /users/{userID} {
      // The public user doc holds exactly these keys. hasOnly() keeps the
      // world-readable document from being used as a spam surface or a stealth
      // data channel; hasAll() keeps a merge write from dropping a field.
      // `trustStats` is optional because only the recomputeTrustStats function
      // ever writes it, and it does so with admin credentials that bypass this.
      // The name-search index (UserSearchTerms in the client). Optional: it is
      // absent on documents written before the backfill, and search simply does
      // not find those until scripts/backfill_search_terms.js runs.
      //
      // Rules cannot loop, so the individual prefixes can't be checked against
      // the name — a modified client could add terms it never earned and make
      // itself findable under words that aren't its own. Bounded rather than
      // prevented: the size cap limits how much of that is possible, and the
      // whole lowercased displayName must be present, so the terms can never
      // disown the name they belong to. Being findable is not access — a
      // stranger still has to be accepted as a friend to see anything — but
      // when functions deploy, onUserWritten should own this field outright
      // (section B).
      function isValidSearchTerms(data) {
        return isUnset(data, 'searchTerms')
            || (data.searchTerms is list
                && data.searchTerms.size() <= 60
                && data.searchTerms.hasAll([data.displayName.lower()]));
      }

      function isValidPublicProfile(data) {
        return data.keys().hasOnly(['displayName', 'searchTerms', 'createdAt', 'updatedAt', 'trustStats'])
            && data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
            && data.displayName is string
            && data.displayName.size() > 0
            && data.displayName.size() < 200
            && isValidSearchTerms(data)
            && data.createdAt is timestamp
            && data.updatedAt == request.time;
      }

      // Full members only: the public projection is readable by any real
      // account for name display, but not by an anonymous guest minted from the
      // public web config, which would otherwise let anyone enumerate the whole
      // user base. Elevated get()/exists() in other rules still read it freely.
      allow read: if isFullMember();

      allow create: if isSignedIn()
          && isOwner(userID)
          && isValidPublicProfile(request.resource.data)
          && request.resource.data.createdAt == request.time
          // Reputation is earned, never claimed on the way in (feature 2).
          && isUnset(request.resource.data, 'trustStats');

      allow update: if isSignedIn()
          && isOwner(userID)
          && isValidPublicProfile(request.resource.data)
          // createdAt must not change
          && request.resource.data.createdAt == resource.data.createdAt
          // Neither may trustStats: a host must not be able to award themselves a
          // verified badge, a five-star average, or a hundred completed stays.
          // Cloud Functions write it with admin credentials, which skip this rule.
          && request.resource.data.get('trustStats', null) == resource.data.get('trustStats', null);

      allow delete: if false;

      // Owner-only private data. Readable and writable exclusively by the owner;
      // Cloud Functions still reach it through elevated get()/exists().
      match /private/{docID} {
        allow read, write: if isSignedIn() && isOwner(userID);
      }

      // The host's circles. Owner-only in both directions, and the read side
      // matters as much as the write side: a circle carries a *name*, and
      // "Acquaintance" is precisely the decline this feature exists to spare
      // people. Firestore has no field-level read rules, so the rules a guest's
      // client legitimately needs are projected into `bookingPolicies` below
      // instead of being read from here.
      match /circles/{circleID} {
        function isValidCircle(data) {
          return data.keys().hasOnly(['name', 'isDefault', 'sortOrder', 'policy', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['name', 'isDefault', 'sortOrder', 'policy'])
              && data.name is string
              && data.name.size() > 0
              && data.name.size() <= 40
              && data.sortOrder is int
              // Being the Default circle is a fact about the document id, never
              // a claim the document makes. Every policy resolution ends at this
              // id, so exactly one document can hold that role and it is the one
              // the path names.
              && data.isDefault == (circleID == defaultCircleID())
              && isValidBookingPolicy(data.policy);
        }

        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidCircle(request.resource.data);
        // Default cannot be deleted — a new friend always needs somewhere to
        // land, and the resolution chain has to end somewhere that exists.
        // Renaming it and rewriting its policy are ordinary updates above; there
        // is nothing else special about it.
        allow delete: if isSignedIn() && isOwner(userID) && circleID != defaultCircleID();
      }

      // Which circle each friend is in, plus any policy the host set on that one
      // person. Keyed by the friend's uid so a booking resolves in one get().
      match /circleMembers/{friendID} {
        function isValidMembership(data) {
          return data.keys().hasOnly(['circleID', 'overridePolicy', 'updatedAt'])
              && data.keys().hasAll(['circleID'])
              && data.circleID is string
              && data.circleID.size() > 0
              && data.circleID.size() <= 200
              && (data.get('overridePolicy', null) == null
                  || isValidBookingPolicy(data.overridePolicy));
        }

        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidMembership(request.resource.data);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The resolved policy, projected for one guest — the only part of Circles
      // a guest may read, and only their own. It carries the three rules and
      // nothing else: no circle id, no circle name, no count of circles, nothing
      // that reveals the host sorts anyone at all.
      //
      // A display cache in the same sense a listing's `unavailableDateRanges`
      // is one. The rules above are the boundary; this exists so the request
      // sheet can decline to *offer* what the rules would refuse, which is what
      // keeps a restricted friend from ever meeting an error.
      match /bookingPolicies/{guestID} {
        allow read: if isSignedIn() && (isOwner(userID) || isOwner(guestID));
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && isValidBookingPolicy(request.resource.data);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The host's private notes on their friends — what they'd write on the
      // back of an index card so they can remember, months later, why somebody
      // sits in the circle they sit in.
      //
      // Read is the owner and nobody else. Not the friend the note is about,
      // not a moderator, not a Cloud Function, not the other side of a stay it
      // names. That is the entire feature: a host writes candidly only if
      // "private" means the document, not the screen, and the caller this has
      // to hold against is the technically-minded friend reading raw documents
      // rather than the app. There is deliberately no second branch on this
      // read rule to audit later, and nothing anywhere projects a note, a count
      // of notes, or a derived score out to any other reader.
      //
      // Note the shape of the surrounding file too: `isAdmin()` appears only on
      // `reports`, so there is no ambient moderator read over `users/**` that
      // would quietly widen this one.
      match /friendNotes/{noteID} {
        function isValidNote(data) {
          return data.keys().hasOnly(['subjectUserID', 'text', 'stayRequestID', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['subjectUserID', 'text'])
              && data.subjectUserID is string
              && data.subjectUserID.size() > 0
              && data.subjectUserID.size() <= 128
              // A note about yourself is not a thing this feature is for, and
              // allowing it would put host-authored text on the one profile the
              // host might later hand somebody else to look at.
              && data.subjectUserID != userID
              && data.text is string
              && data.text.size() > 0
              // Mirrors FriendNote.maxLength in the Swift client.
              && data.text.size() <= 2000
              && (data.get('stayRequestID', null) == null
                  || (data.stayRequestID is string
                      && data.stayRequestID.size() > 0
                      && data.stayRequestID.size() <= 200));
        }

        allow read: if isSignedIn() && isOwner(userID);

        allow create: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data);

        // Editing changes the text (and may attach or clear a stay). It must not
        // re-point the note at a different person: a note re-filed under someone
        // else keeps its date and reads as contemporaneous evidence about them,
        // which is the one way this could become unfair to a friend who never
        // sees it. `createdAt` is pinned for the same reason it is on a review.
        allow update: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data)
            && request.resource.data.subjectUserID == resource.data.subjectUserID
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

        allow delete: if isSignedIn() && isOwner(userID);
      }

      // Which post-stay note prompts this host has already answered or waved
      // off, so the app asks once and then leaves them alone. Deliberately
      // separate documents from the notes themselves: this says a prompt was
      // *seen*, carries no text, and is the only part of the feature that would
      // ever be worth syncing across a host's devices.
      match /friendNotePrompts/{stayRequestID} {
        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && request.resource.data.keys().hasOnly(['dismissedAt'])
            && request.resource.data.keys().hasAll(['dismissedAt']);
        allow delete: if isSignedIn() && isOwner(userID);
      }

      // The guest's private notes on the hosts they stay with and the listings
      // they consider — the symmetric twin of `friendNotes` above, read from the
      // other side of the same stay. The host-side note protects a host from a
      // repeat bad guest; this protects nobody and is not meant to. It is the
      // guest's own reference material, so a guest who had a rough stay has a
      // record of their own.
      //
      // Read is the owner and nobody else. Not the host the note is about, not a
      // moderator, not a Cloud Function, not the other side of a stay it names.
      // That is the entire feature, and the caller it has to hold against is the
      // technically-minded host reading raw documents rather than the app. There
      // is deliberately no second branch on this read rule — no `isAdmin()` reach
      // here, exactly as there is none on `friendNotes`; the app's moderation
      // queue lives at `reports`, and a note is deliberately not a report.
      // Nothing anywhere projects a note, a count of notes, or a derived score
      // out to any other reader.
      //
      // Unlike a friend note, whose subject is always a person, a guest note
      // points at a host (a user) or a listing (a home). `subjectType` says
      // which, and `subjectID` is that thing's id; the update rule pins both, so
      // a note can never be re-filed from one host onto another, or off a host
      // onto a listing, while keeping its date.
      match /guestNotes/{noteID} {
        function isValidNote(data) {
          return data.keys().hasOnly(['subjectType', 'subjectID', 'text', 'stayRequestID', 'createdAt', 'updatedAt'])
              && data.keys().hasAll(['subjectType', 'subjectID', 'text'])
              && data.subjectType in ['host', 'listing']
              && data.subjectID is string
              && data.subjectID.size() > 0
              && data.subjectID.size() <= 200
              // A `host` note about yourself is not a thing this feature is for,
              // the same way a friend note about yourself isn't: it would put
              // guest-authored text on the one profile you might later hand
              // somebody else to look at. A listing you happen to host is a
              // different id space and carries no such profile, so only the host
              // case is barred here.
              && !(data.subjectType == 'host' && data.subjectID == userID)
              && data.text is string
              && data.text.size() > 0
              // Mirrors GuestNote.maxLength in the Swift client.
              && data.text.size() <= 2000
              && (data.get('stayRequestID', null) == null
                  || (data.stayRequestID is string
                      && data.stayRequestID.size() > 0
                      && data.stayRequestID.size() <= 200));
        }

        allow read: if isSignedIn() && isOwner(userID);

        allow create: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data);

        // Editing changes the text (and may attach or clear a stay). It must not
        // re-point the note at a different host or listing: a note re-filed under
        // someone else keeps its date and reads as contemporaneous evidence about
        // them, which is the one way this could become unfair to a host who never
        // sees it. `createdAt` is pinned for the same reason it is on a friend
        // note.
        allow update: if isSignedIn()
            && isOwner(userID)
            && isValidNote(request.resource.data)
            && request.resource.data.subjectType == resource.data.subjectType
            && request.resource.data.subjectID == resource.data.subjectID
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

        allow delete: if isSignedIn() && isOwner(userID);
      }

      // Which post-trip note prompts this guest has already answered or waved
      // off, so the app asks once and then leaves them alone. The mirror of
      // `friendNotePrompts`: this says a prompt was *seen*, carries no text, and
      // is the only part of the feature that would ever be worth syncing across
      // a guest's devices.
      match /guestNotePrompts/{stayRequestID} {
        allow read: if isSignedIn() && isOwner(userID);
        allow create, update: if isSignedIn()
            && isOwner(userID)
            && request.resource.data.keys().hasOnly(['dismissedAt'])
            && request.resource.data.keys().hasAll(['dismissedAt']);
        allow delete: if isSignedIn() && isOwner(userID);
      }
    }

    // -------------------------------------------------------------------------
    // Homes / Listings
    // A listing is readable only by its host, its co-hosts, and the users named
    // in `allowedViewerIDs` — the host's accepted friends, denormalized onto the
    // document because rules cannot join to `friendEdges`. There are no wider
    // tiers: no public listings and no friends-of-friends reach. Someone two
    // hops out is surfaced as a friend *suggestion* instead, and sees the
    // listing only after the host accepts them as a friend.
    //
    // Clients therefore cannot query `homes` unfiltered: a query is rejected
    // outright if any matched document fails the read rule. The feed issues the
    // one provably-safe query — `allowedViewerIDs contains me` — which also
    // covers the host's own listings, since the ACL always names the host.
    //
    // The legacy `visibility` field ('everyone' / 'friendsOnly' /
    // 'friendsOfFriends') is gone: writes carrying it are rejected outright by
    // the key allowlist below, and scripts/migrate_friends_only.js strips it
    // from pre-migration documents while rebuilding every ACL to host +
    // accepted friends. A pre-migration document remains readable under the
    // ACL gate but cannot be updated until migrated.
    //
    // Only the host may write their own listings.
    // -------------------------------------------------------------------------
    match /homes/{homeID} {
      // Every key the Home model encodes. Optional fields are omitted by the
      // encoder when nil, so hasOnly() (not hasAll()) is the right check for
      // the tail of this list.
      function isValidListing(data) {
        return data.keys().hasOnly([
                 'id', 'hostUserID', 'hostName', 'title', 'address', 'description',
                 'contactPreference', 'hostContactInfo', 'hostMotivation',
                 'sleeping', 'guestPolicy', 'amenities', 'cancellationPolicy',
                 'photoURLs', 'unavailableDateRanges',
                 'latitude', 'longitude',
                 'geohash', 'allowedViewerIDs', 'coHostUserIDs',
                 'deletedAt', 'createdAt'
               ])
            && data.keys().hasAll([
                 'hostUserID', 'hostName', 'address',
                 'sleeping', 'guestPolicy', 'amenities'
               ])
            && data.hostUserID is string
            && data.hostName is string
            && data.hostName.size() > 0
            && data.hostName.size() < 200
            // Nested struct validation
            && data.address is map
            // The public address is city-level. `street` belongs in the private
            // location subdocument; rejecting it here is what keeps a modified
            // client from putting it back on the world-readable document.
            && data.address.keys().hasOnly(['city', 'state', 'zip'])
            && data.address.keys().hasAll(['city', 'state'])
            && data.sleeping is map
            && data.guestPolicy is map
            && data.amenities is map
            && data.sleeping.numGuestRooms is int
            && data.guestPolicy.maxGuests is int
            && data.guestPolicy.maxStayDays is int
            // Size caps so a document can't be stuffed toward the 1 MiB limit.
            // The 60-char title cap mirrors CreateListingViewModel.titleMaxLength.
            && isOptionalString(data, 'title', 60)
            && isOptionalString(data, 'description', 2000)
            && isOptionalString(data, 'hostContactInfo', 500)
            && isOptionalList(data, 'photoURLs', 10)
            // The merged calendar, and the only availability field this
            // world-readable document is allowed to carry. `blockedDateRanges` and
            // `bookedDateRanges` are absent from the key allowlist above on
            // purpose: Firestore grants reads per document, never per field, so a
            // listing that published both halves let any viewer subtract one from
            // the other and learn which nights the home was occupied. They live in
            // `private/availability` now, and this rule is what stops a modified
            // client putting them back. The cap is the sum of the two former caps,
            // since this is their union.
            && isOptionalList(data, 'unavailableDateRanges', 200)
            // Enums and coordinates: a value the client can't decode makes the
            // listing silently disappear from the feed (see A5).
            && (isUnset(data, 'contactPreference')
                || data.contactPreference in ['inApp', 'contactInfo'])
            && (isUnset(data, 'hostMotivation')
                || data.hostMotivation in ['eager', 'open', 'selective'])
            && (isUnset(data, 'cancellationPolicy')
                || data.cancellationPolicy in ['flexible', 'moderate', 'strict'])
            // The read ACL. A host may grant whoever they like access to their own
            // listing, so the only constraints are a size cap (this array is
            // downloaded with every feed document) and that the host cannot lock
            // themselves out of their own listing.
            && isOptionalList(data, 'allowedViewerIDs', 1000)
            && (isUnset(data, 'allowedViewerIDs')
                || data.allowedViewerIDs.hasAll([data.hostUserID]))
            // Co-hosts (feature 14). A partner or roommate, not a second owner:
            // capped small, and never the host themselves, whose powers are not
            // a subset of a co-host's and must not be confused with them.
            && isOptionalList(data, 'coHostUserIDs', 5)
            && !data.get('coHostUserIDs', []).hasAny([data.hostUserID])
            && (isUnset(data, 'latitude') || data.latitude is number)
            && (isUnset(data, 'longitude') || data.longitude is number)
            && isOptionalString(data, 'geohash', 12)
            && (isUnset(data, 'deletedAt') || data.deletedAt is timestamp)
            && (isUnset(data, 'createdAt') || data.createdAt is timestamp);
      }

      // Each read clause corresponds to one client query: the feed's
      // `allowedViewerIDs contains me`, the host's own-listings query, and the
      // co-host's `coHostUserIDs contains me`. Keep them in sync: a query that
      // isn't provably covered by one clause is rejected wholesale, not filtered.
      // The keys a co-host may rewrite: the description of the home itself.
      // Everything absent from this list — who hosts the listing, how to reach
      // them, who can see it, who else may manage it, and whether it still
      // exists — is thereby pinned, because `changedKeys().hasOnly()` rejects any
      // write that touches a key outside it.
      function coHostEditableKeys() {
        return ['description', 'hostMotivation', 'sleeping', 'guestPolicy',
                'amenities', 'cancellationPolicy', 'photoURLs',
                'unavailableDateRanges',
                'latitude', 'longitude', 'geohash'];
      }

      // The co-hosts this write adds. Rules cannot loop, so a roster change is
      // admitted one addition at a time and that one is checked against the
      // friend graph; see the update rule.
      function addedCoHosts() {
        return request.resource.data.get('coHostUserIDs', [])
                 .removeAll(resource.data.get('coHostUserIDs', []));
      }

      // A co-host can read the listing they manage even if the host later
      // unfriends them and drops them out of `allowedViewerIDs`. The roster is
      // the grant; removing someone from it is how you take it back. This clause
      // is what makes the client's `coHostUserIDs contains me` query legal.
      allow read: if isSignedIn()
          && (resource.data.hostUserID == request.auth.uid
              || request.auth.uid in resource.data.get('allowedViewerIDs', [])
              || request.auth.uid in resource.data.get('coHostUserIDs', []));

      allow create: if isFullMember()
          && request.resource.data.hostUserID == request.auth.uid
          // New listings stamp the server time the feed orders by (L3).
          && request.resource.data.createdAt == request.time
          // A listing is born with no co-hosts. Admitting a roster here would
          // mean validating every name in it against the friend graph, and rules
          // cannot loop — so co-hosts are added afterwards, one update at a time.
          && request.resource.data.get('coHostUserIDs', []).size() == 0
          && isValidListing(request.resource.data);

      // Update re-validates the whole document. Without this a host could
      // corrupt their own listing into a shape the client cannot decode, and
      // decode failures are silently dropped, so the listing would just vanish.
      allow update: if isSignedIn()
          // hostUserID is immutable after creation. This is what stops a co-host
          // from writing themselves into the host's chair, and it is checked
          // before either branch below so neither can forget it.
          && request.resource.data.hostUserID == resource.data.hostUserID
          // createdAt is immutable once set. A legacy listing that predates the
          // field may stamp it (to request.time) on its next edit, never rewrite.
          && (request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
              || (resource.data.get('createdAt', null) == null
                  && request.resource.data.createdAt == request.time))
          && isValidListing(request.resource.data)
          && (
            // The host. May rewrite anything the validator allows, including the
            // co-host roster — but only one addition per write, because that is
            // the most a loop-free rule can check against the friend graph. A
            // co-host must be an accepted friend: they are about to be handed the
            // street address, and "co-host" must not become a way to grant a
            // stranger read access to the host's front door. Removals are
            // unconstrained; taking a capability back is always safe.
            (isOwner(resource.data.hostUserID)
                && (addedCoHosts().size() == 0
                    || (addedCoHosts().size() == 1
                        && areFriends(addedCoHosts()[0], resource.data.hostUserID))))
            ||
            // A co-host. May describe the home — its capacity, amenities,
            // availability, photos — and nothing else. In particular they cannot
            // touch `allowedViewerIDs` (which the client rebuilds from the saving
            // user's friends, and which would silently republish a friends-only
            // listing to a second social graph the host never saw), `visibility`,
            // `hostName`, the host's contact details, the co-host roster, or
            // `deletedAt`. That last one is why a co-host cannot soft-delete a
            // listing through the update rule after being refused the delete rule.
            (resource.data.get('coHostUserIDs', []).hasAny([request.auth.uid])
                && changedKeys().hasOnly(coHostEditableKeys()))
          );

      // Host only. Deleting someone else's listing is not "managing" it, and a
      // soft delete is unrecoverable from the client.
      allow delete: if isSignedIn()
          && resource.data.hostUserID == request.auth.uid;

      // -----------------------------------------------------------------------
      // Private listing data. Three documents live here, and they do not all
      // share a visibility rule:
      //   - `location`:     the exact street address and unrounded coordinates.
      //   - `manual`:       the host's check-in guide (feature 15).
      //   - `availability`: the calendar with blocked and booked still apart.
      //
      // `location` and `manual` are progressively disclosed: the managers plus a
      // guest whose stay the host has accepted, never world-readable, because the
      // public listing carries only city/state/zip and a coordinate rounded to
      // roughly a kilometre.
      //
      // `availability` is disclosed to nobody outside the managers, accepted
      // guests included. Being accepted earns you the street you were invited to;
      // it never earns you which of the host's other closed days were bookings.
      // The public listing publishes only the union of the two halves, and the
      // whole point of keeping them here is that no reader can undo that merge.
      // -----------------------------------------------------------------------
      function isValidLocation(data) {
        return data.keys().hasOnly(['street', 'latitude', 'longitude'])
            && data.street is string
            && data.street.size() > 0
            && data.street.size() < 300
            && (isUnset(data, 'latitude') || data.latitude is number)
            && (isUnset(data, 'longitude') || data.longitude is number);
      }
      // Every field the HouseManual model encodes; all optional free text with
      // size caps so the document can't be stuffed toward the 1 MiB limit.
      function isValidManual(data) {
        return data.keys().hasOnly([
                 'checkInInstructions', 'wifiNetwork', 'wifiPassword',
                 'keyHandoff', 'houseNotes', 'hostPhone'
               ])
            && isOptionalString(data, 'checkInInstructions', 2000)
            && isOptionalString(data, 'wifiNetwork', 200)
            && isOptionalString(data, 'wifiPassword', 200)
            && isOptionalString(data, 'keyHandoff', 2000)
            && isOptionalString(data, 'houseNotes', 2000)
            && isOptionalString(data, 'hostPhone', 40);
      }
      // The two halves of the calendar, plus the host's turnover buffer. Caps
      // match the former per-field caps on the public document, whose merged field
      // is now capped at their sum. `bufferHours` is the gap held around every
      // confirmed stay (feature: turnover buffer); it is validated but not
      // range-checked against the calendar here, for the same reason the
      // double-booking guard lives in the accept transaction and not these rules:
      // a rule cannot loop over ranges. Bounds mirror
      // ListingAvailability.maxBufferHours.
      function isValidAvailability(data) {
        return data.keys().hasOnly(['blockedDateRanges', 'bookedDateRanges', 'bufferHours'])
            && isOptionalList(data, 'blockedDateRanges', 100)
            && isOptionalList(data, 'bookedDateRanges', 100)
            && (isUnset(data, 'bufferHours')
                || (data.bufferHours is int
                    && data.bufferHours >= 0
                    && data.bufferHours <= 168));
      }

      // `bookedDateRanges` is derived from accepted stays, and used to be pinned
      // against every client because a Cloud Function owned it. That trigger is
      // not deployed, so a pinned field is not a server-owned field — it is a
      // field nothing writes, and a booked half that never learns about a booking.
      // The host owns it now: their app recomputes it from the listing's accepted
      // stays (the client stand-in for `onStayRequestWritten`) and writes it here.
      //
      // Loosening it costs no privacy — this whole document is managers-only, so
      // the reason it was split from the public listing (guests must not tell a
      // booking from a blocked day) is untouched. And it was already
      // manager-gated, so "a client could park a booking on a rival's calendar"
      // was never reachable: a client may only write listings it manages, and a
      // manager over-booking their own calendar harms only themselves.

      // A co-host reads and writes these documents: a roommate who cannot see the
      // street address or the door code cannot let a guest in, and the check-in
      // instructions are exactly the thing they are there to keep current.
      match /private/{docID} {
        // The accepted-guest branch deliberately excludes `availability`. Without
        // that exclusion an accepted guest would read the unmerged calendar and
        // the split above would buy nothing: one accepted stay, anywhere, and the
        // host's bookings are legible again.
        allow read: if isSignedIn()
            && (isListingManager(homeID)
                || (docID != 'availability'
                    && exists(/databases/$(database)/documents/homes/$(homeID)/accepted/$(request.auth.uid))));

        allow create, update: if isFullMember()
            && isListingManager(homeID)
            && ((docID == 'location' && isValidLocation(request.resource.data))
                || (docID == 'manual' && isValidManual(request.resource.data))
                || (docID == 'availability'
                    && isValidAvailability(request.resource.data)));

        // `availability` is excluded: the host reconciles it in place, never by
        // deleting it, and a stray delete would drop the booked half a guest's
        // accepted stay depends on. `onHomeDeleted` cascades the subcollection as
        // admin, which these rules do not apply to.
        allow delete: if isFullMember()
            && isListingManager(homeID)
            && docID != 'availability';
      }

      // -----------------------------------------------------------------------
      // Accepted-guest markers. Existence is the capability: the private location
      // rule above checks for `accepted/{callerUID}`. A manager writes one when
      // accepting a stay and removes it if the stay is later declined or
      // cancelled; the guest may remove their own to give the address back.
      //
      // This block used to ask `isListingHost` throughout, on the reasoning that
      // admitting a stranger into someone's home is the host's decision and not a
      // co-host's. It said so, and it said that if stay requests ever reached a
      // co-host, "these two must change together". They have: `isHostSide` now
      // lets a co-host answer requests for the listings they manage, and `create`
      // below already moved to `isListingManager` so the grant could be written in
      // the same commit as the acceptance.
      //
      // Read and delete had not moved with it, which left a co-host able to issue
      // a grant they could not read back, and — worse — able to cancel an accepted
      // stay while unable to revoke its address. That second one is not a
      // theoretical asymmetry: `updateStatus` sends the status change and the
      // marker delete as one batch, and a batch is atomic, so the cancel failed
      // outright rather than leaving the address behind. All three now ask the
      // same question.
      // -----------------------------------------------------------------------
      match /accepted/{guestID} {
        allow read: if isSignedIn()
            && (request.auth.uid == guestID || isListingManager(homeID));

        // The grant is issued alongside a real acceptance, by whichever side does
        // the accepting: a manager accepting a request, or the guest accepting the
        // host's offer. Both are legitimate disclosures — the offer was the host
        // choosing to host this guest, and acceptance is the moment the address is
        // theirs to know.
        //
        // This was `false`, on the reasoning that only the callable should ever
        // disclose an address. The callable is not deployed, so that rule made the
        // address undisclosable rather than carefully disclosed. What keeps it from
        // being a forgery hole is `getAfter`: it reads post-commit state, so the
        // named request must *itself* be accepted, for this listing, for this
        // guest, when the batch settles. Neither side can mint a grant for a
        // request that never got accepted, point one at a different listing, or
        // leave one behind by accepting and rolling back — the write lands with a
        // matching accepted request or not at all.
        //
        // The guest cannot forge the offer that entitles them: an `offered`
        // request can only be created by its host (the create rule pins
        // `hostUserID == auth.uid` on that path), so a guest writing their own
        // grant is always downstream of a host who chose to host them.
        allow create: if isFullMember()
            && (isListingManager(homeID) || request.auth.uid == guestID)
            && request.resource.data.keys().hasOnly(['requestID', 'guestUserID', 'createdAt'])
            && request.resource.data.guestUserID == guestID
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.guestUserID == guestID
            && getAfter(/databases/$(database)/documents/stayRequests/$(request.resource.data.requestID))
                 .data.listingID == homeID;

        // A grant is not editable in place; revoke and re-issue.
        allow update: if false;

        // Revoking is the safe half of the pair: taking an address back can be
        // done by anyone entitled to have granted it, and by the guest handing it
        // in. A co-host who may cancel the stay must be able to revoke with it.
        allow delete: if isSignedIn()
            && (request.auth.uid == guestID || isListingManager(homeID));
      }
    }

    // -------------------------------------------------------------------------
    // Stay requests
    // Guests create pending requests; hosts accept/decline; guests can cancel.
    // No edits once a request reaches a terminal state (declined / cancelled).
    // -------------------------------------------------------------------------
    match /stayRequests/{requestID} {
      // The two parties, plus any co-host of the listing being asked about — the
      // co-host branch is what makes the client's `listingID in [...]` inbox
      // query legal (feature 14). Listed last so the parties' reads short-circuit
      // before the listing lookup.
      allow read: if isSignedIn()
          && (request.auth.uid == resource.data.guestUserID
              || request.auth.uid == resource.data.hostUserID
              || isListingManager(resource.data.listingID));

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'listingID', 'listingCity', 'listingTitle', 'listingHostName',
               'hostUserID', 'guestUserID', 'checkIn', 'checkOut',
               'guestNote', 'hostNote', 'guestCount', 'arrivalWindow',
               'status', 'initiatedBy', 'completedAt', 'createdAt', 'updatedAt'
             ])
          // Denormalized listing title, snapshotted at request time (optional).
          // Same 60-char cap as the listing's own title.
          && isOptionalString(request.resource.data, 'listingTitle', 60)
          // A stay cannot be born finished.
          && isUnset(request.resource.data, 'completedAt')
          // Two ways a stay can start, and the creator must be the party the
          // status says started it (feature 43). Pinned together so neither can
          // be forged: a guest cannot create a document that claims the host
          // offered, and a host cannot manufacture a "request" from a friend who
          // never asked — which would otherwise let a host fabricate a stay and
          // then accept it themselves, minting trust stats out of nothing.
          && (
            // The guest asks. `initiatedBy` is optional here purely so the field
            // stays absent on the path that predates offers.
            (request.resource.data.guestUserID == request.auth.uid
                && request.resource.data.status == "pending"
                && (isUnset(request.resource.data, 'initiatedBy')
                    || request.resource.data.initiatedBy == request.auth.uid)
                // A host's note is the host's to write, and only on a reply.
                && isUnset(request.resource.data, 'hostNote')
                // The host's circle policy for this friend, enforced on the ask
                // and only on the ask: a policy governs what a friend may
                // request, and a host offering their own place is not asking.
                //
                // Nothing here produces a distinguishable failure. A guest whose
                // client is current never reaches these clauses, because the
                // request sheet does not offer what they would refuse; a guest
                // whose client is stale sees the same generic "no longer
                // available" a lost race already gives them. Neither is told a
                // circle exists.
                && bookingPermitted(request.resource.data.hostUserID, request.auth.uid,
                                    request.resource.data, true))
            ||
            // The host offers. The mirror: the host writes the note, and the
            // guest's own fields (their note, their party size, their arrival
            // time) are theirs to fill in if they accept — the host must not put
            // words in their mouth.
            //
            // The friendship is checked here directly, and deliberately *not*
            // left to the `allowedViewerIDs` gate below. On the guest path that
            // ACL is a real boundary, because a guest cannot edit someone else's
            // listing. On this path the caller is the host, who writes that array
            // themselves — so adding an arbitrary uid to their own listing and
            // then "offering" to them would land an unsolicited stay, with a
            // 2000-character note, in the trip list of any user in the app. The
            // ACL cannot gate a write by the person who authors the ACL.
            // `onHomeWrittenACL` scrubs a hand-written roster, but it runs after
            // the fact and is not deployed everywhere, so the invariant belongs
            // in the rule rather than in a trigger.
            (request.resource.data.hostUserID == request.auth.uid
                && request.resource.data.status == "offered"
                && request.resource.data.initiatedBy == request.auth.uid
                && request.resource.data.guestUserID != request.auth.uid
                && areFriends(request.resource.data.guestUserID, request.auth.uid)
                && isUnset(request.resource.data, 'guestNote')
                && isUnset(request.resource.data, 'guestCount')
                && isUnset(request.resource.data, 'arrivalWindow')
                && isOptionalString(request.resource.data, 'hostNote', 2000))
          )
          && request.resource.data.hostUserID is string
          && request.resource.data.hostUserID.size() > 0
          && request.resource.data.listingID is string
          && request.resource.data.listingID.size() > 0
          && request.resource.data.checkIn is timestamp
          && request.resource.data.checkOut is timestamp
          && request.resource.data.checkOut > request.resource.data.checkIn
          // Check-in must not be in the past. checkIn is a local start-of-day, so
          // a one-day grace keeps a same-day request valid regardless of the
          // guest's timezone offset from UTC while still rejecting stale dates.
          && request.resource.data.checkIn > request.time - duration.value(1, 'd')
          // The named host must actually own the (live) listing being requested,
          // so a request can't be aimed at an arbitrary user's inbox (S8).
          && listingHasActiveHost(request.resource.data.listingID, request.resource.data.hostUserID)
          // Only someone the listing is shared with may knock: the guest must be
          // in its read ACL. Without this, any member holding a leaked listing id
          // could file requests into a host's inbox, straight past the
          // friends-only boundary. The get() is cached with the ones
          // listingHasActiveHost already did, so it costs no extra read.
          //
          // Keyed to guestUserID rather than the caller, which is what makes it
          // hold for both directions (feature 43). On the guest path the two are
          // the same uid, pinned above. On the host path the caller is the host,
          // who is always in their own listing's ACL — so checking the caller
          // there would check nothing at all, and would let a host offer their
          // place to someone who cannot even see it.
          //
          // This clause carries the guest path on its own, because a guest cannot
          // edit the ACL it reads. It does *not* carry the host path, where the
          // caller authors the array being checked; that direction is gated by
          // the explicit areFriends() on the offer branch above. Keep both.
          && request.resource.data.guestUserID in
               get(/databases/$(database)/documents/homes/$(request.resource.data.listingID))
                 .data.get('allowedViewerIDs', [])
          // A block severs this the same way it severs a thread (S11). Between the
          // two parties, for the same reason as above: on the host path the caller
          // *is* the host, and blockedEitherWay(host, host) is vacuously false.
          && !blockedEitherWay(request.resource.data.guestUserID, request.resource.data.hostUserID)
          // The inbox and trip lists order by createdAt; pin it so a request
          // cannot backdate itself. The client's @ServerTimestamp field encodes
          // to the server-timestamp sentinel, which equals request.time here.
          && request.resource.data.createdAt == request.time
          && isOptionalString(request.resource.data, 'guestNote', 2000)
          // Party size, when given, is a positive int no larger than the
          // listing's advertised capacity (feature 20).
          && (isUnset(request.resource.data, 'guestCount')
              || (request.resource.data.guestCount is int
                  && request.resource.data.guestCount >= 1
                  && request.resource.data.guestCount <= listingMaxGuests(request.resource.data.listingID)))
          && (isUnset(request.resource.data, 'arrivalWindow')
              || request.resource.data.arrivalWindow in
                   ['flexible', 'morning', 'afternoon', 'evening', 'lateNight']);

      // Status transitions may touch nothing but the status, the note belonging
      // to the acting role, and updatedAt. Everything else — checkIn, checkOut,
      // guestNote, listingID, the participant IDs, createdAt — is pinned by
      // affectedKeys(), so a host cannot rewrite the dates while "accepting"
      // and a guest cannot rewrite them while cancelling.
      allow update: if isSignedIn()
          && (
            // Name propagation: a host rewrites only the denormalized
            // listingHostName on requests they host, so a rename doesn't leave
            // trip rows showing the old name (L7). Allowed on any status, since
            // past trips should show the current name too; touches nothing else.
            (isOwner(resource.data.hostUserID)
                && changedKeys().hasOnly(['listingHostName'])
                && request.resource.data.listingHostName is string
                && request.resource.data.listingHostName.size() > 0
                && request.resource.data.listingHostName.size() < 200)
            ||
            // Date change on a still-pending request (feature 23): the guest may
            // move checkIn/checkOut in place rather than cancel and re-send. Only
            // the guest, only while pending, and changedKeys() pins everything
            // else — status included — so this can never double as an accept or a
            // rewrite of the participant IDs. The date validity rules mirror
            // create: end after start, and start not already in the past.
            (isOwner(resource.data.guestUserID)
                && resource.data.status == "pending"
                && changedKeys().hasOnly(['checkIn', 'checkOut', 'updatedAt'])
                && request.resource.data.updatedAt == request.time
                && request.resource.data.checkIn is timestamp
                && request.resource.data.checkOut is timestamp
                && request.resource.data.checkOut > request.resource.data.checkIn
                && request.resource.data.checkIn > request.time - duration.value(1, 'd')
                // A date change is a second chance to break the notice rule:
                // ask for a date three months out, then walk it back to
                // tomorrow. The same bound applies here as on create. It spends
                // no new frequency slot — this is the same request, not another
                // one — and the arrival window is pinned by changedKeys().
                && bookingPermitted(resource.data.hostUserID, request.auth.uid,
                                    request.resource.data, false))
            ||
            // Status transitions: no edits once the request is terminal.
            (resource.data.status in ["pending", "offered", "accepted"]
                && request.resource.data.updatedAt == request.time
                && (
                  // Host declines a pending request. Acceptance is NOT a client
                  // write: it goes through the acceptStayRequest callable, whose
                  // admin transaction is the race-free double-booking guard (L1).
                  (isHostSide(resource.data)
                      && resource.data.status == "pending"
                      && request.resource.data.status == "declined"
                      && changedKeys().hasOnly(['status', 'hostNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Host side accepts a pending request. This was the callable's
                  // alone, because only an admin could read every accepted stay on
                  // the listing and rule out a double-booking. The callable is not
                  // deployed — this project has no Cloud Functions in production —
                  // so the choice was not "client or server" but "client or not at
                  // all", and a booking app that cannot accept a booking is not a
                  // booking app.
                  //
                  // What replaces the admin query is a client transaction over
                  // `private/availability`, which is one document rather than a
                  // query, so a client transaction can serialize on it: two devices
                  // accepting at once contend on the same document and the loser
                  // retries against the winner's write. That is the same guarantee
                  // for the case the guard was written for (one host, two devices)
                  // and a weaker one against a modified client, which these rules
                  // cannot check without looping over ranges.
                  //
                  // Deliberately narrower than the callable: only `pending`, and
                  // only the host side. A guest accepting an *offer* still needs
                  // the callable, because the document that would let them check
                  // overlap is one they are forbidden to read, and the marker below
                  // is not theirs to write.
                  (isHostSide(resource.data)
                      && resource.data.status == "pending"
                      && request.resource.data.status == "accepted"
                      && changedKeys().hasOnly(['status', 'hostNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Guest declines a host's offer (feature 43): the mirror of the
                  // branch above. Their note goes in guestNote, because hostNote
                  // belongs to the host who wrote the offer and overwriting it
                  // would edit someone else's words. Accepting an offer is a
                  // callable for the same reason accepting a request is — an
                  // offer books the same room, so it needs the same guard.
                  (isOwner(resource.data.guestUserID)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "declined"
                      && changedKeys().hasOnly(['status', 'guestNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'guestNote', 2000))
                  ||
                  // Guest accepts a host's offer. The mirror of the host accepting
                  // a request, and client-side for the same reason: the callable
                  // that used to own it is not deployed, so this was the choice
                  // between a client write and no acceptance at all.
                  //
                  // The guest cannot reach the private calendar, so unlike the host
                  // path this write does not itself carry a serialized overlap
                  // check — the double-booking guard for an offer lives in the
                  // host's booked-range reconciler (the client stand-in for
                  // `onStayRequestWritten`), which recomputes the listing's booked
                  // dates from its accepted stays whenever the host's app sees this
                  // status change. Weaker than the host path's in-transaction
                  // check, and the honest limit of what a guest — who may not read
                  // the calendar they would need to check — can do without a
                  // server. Their own note is the only field they add; hostNote is
                  // the host's, written when they made the offer.
                  (isOwner(resource.data.guestUserID)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "accepted"
                      && changedKeys().hasOnly(['status', 'guestNote', 'updatedAt'])
                      && isOptionalString(request.resource.data, 'guestNote', 2000))
                  ||
                  // Host withdraws an offer the guest hasn't answered. Cancelled
                  // rather than declined: the offer was the host's to retract, and
                  // "declined" would read on the guest's trip list as though they
                  // had turned it down.
                  // `cancelledBy` stays pinned to the listing's host even when a
                  // co-host retracts: it records which *side* backed out, which is
                  // what the push trigger branches on and what the guest's trip
                  // row reads back.
                  (isHostSide(resource.data)
                      && resource.data.status == "offered"
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'hostNote', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.hostUserID
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Guest cancels a pending or accepted request. `cancelledBy`
                  // records which side backed out — the two cancellations are
                  // otherwise indistinguishable on the document, which left the
                  // push trigger unable to tell whom to notify. Pinned to the
                  // caller so neither party can pin the blame on the other.
                  (isOwner(resource.data.guestUserID)
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.guestUserID)
                  ||
                  // Host calls off an accepted stay they can no longer honor
                  // (illness, a burst pipe). Distinct from declining: a pending
                  // request is declined, an accepted stay is cancelled, so the
                  // trip rows read the same whichever side backed out. The note
                  // gives the guest a why, same as a decline's.
                  (isHostSide(resource.data)
                      && resource.data.status == "accepted"
                      && request.resource.data.status == "cancelled"
                      && changedKeys().hasOnly(['status', 'hostNote', 'cancelledBy', 'updatedAt'])
                      && request.resource.data.get('cancelledBy', '') == resource.data.hostUserID
                      && isOptionalString(request.resource.data, 'hostNote', 2000))
                  ||
                  // Either party closes out an accepted stay that has begun
                  // (feature 4). Completion is what unlocks reviews and what
                  // trustStats counts, so the checkIn bound is what stops a host
                  // from farming completed stays by accepting and instantly
                  // "finishing" a booking a year out. completedAt is write-once:
                  // it is unset before this transition, by the create rule above
                  // and by the fact that no other branch may touch it.
                  (resource.data.status == "accepted"
                      && request.resource.data.status == "completed"
                      && (isHostSide(resource.data) || isOwner(resource.data.guestUserID))
                      && changedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
                      && request.resource.data.completedAt == request.time
                      && request.time >= resource.data.checkIn)
                ))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Messages
    // participants is always [smaller_uid, larger_uid] to keep pairs canonical
    // and make the composite index on (participants, timestamp) usable.
    // -------------------------------------------------------------------------
    match /messages/{messageID} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(
               ['id', 'senderUserID', 'text', 'timestamp', 'participants', 'event']
             )
          && validMessageEvent(request.resource.data)
          && request.resource.data.senderUserID == request.auth.uid
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && request.resource.data.participants[0] < request.resource.data.participants[1]
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 5000
          && request.resource.data.timestamp == request.time
          // Reject the message if either party has blocked the other, so a
          // block can't be bypassed by writing to Firestore directly (S11).
          && !blockedEitherWay(
               request.auth.uid,
               request.resource.data.participants[0] == request.auth.uid
                 ? request.resource.data.participants[1]
                 : request.resource.data.participants[0]
             )
          // Enforce the per-user send rate in the write path: the same commit
          // must advance the sender's rateLimits counter, which the rules below
          // cap at MESSAGE_RATE_LIMIT per window (S4).
          && rateCounterAdvanced(request.auth.uid);

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Conversations — the denormalized per-thread summary the client's
    // conversation list and unread badge read from. The `onMessageCreated`
    // Cloud Function owns lastMessage, updatedAt, and the unread increments, and
    // creates the doc (admin writes bypass these rules). Clients may only, on a
    // conversation they belong to, clear their own unread count (mark read) or
    // toggle their own membership in mutedBy (mute/unmute); everything else —
    // participants, lastMessage, the other party's unread and mute state — is
    // pinned. conversationID = sorted participants joined by "_".
    // -------------------------------------------------------------------------
    match /conversations/{conversationID} {
      // The participant who is not the caller. Reads resource.data.participants,
      // so it is only valid on read/update where the doc already exists.
      function conversationOther() {
        return resource.data.participants[0] == request.auth.uid
            ? resource.data.participants[1]
            : resource.data.participants[0];
      }

      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      // Only the trigger (admin) creates summaries.
      allow create: if false;

      allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants
          && (
            // Mark read: zero only my own unread count, leaving the other
            // participant's count (and everything else) untouched.
            (changedKeys().hasOnly(['unreadCounts'])
                && request.resource.data.unreadCounts.get(request.auth.uid, 0) == 0
                && request.resource.data.unreadCounts.get(conversationOther(), 0)
                     == resource.data.unreadCounts.get(conversationOther(), 0))
            ||
            // Mute / unmute: add or remove only myself from mutedBy, leaving the
            // other participant's membership unchanged.
            (changedKeys().hasOnly(['mutedBy'])
                && request.resource.data.mutedBy is list
                && request.resource.data.mutedBy.hasOnly(resource.data.participants)
                && (conversationOther() in request.resource.data.mutedBy)
                     == (conversationOther() in resource.data.get('mutedBy', [])))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Rate-limit counters — one per user, written only in the same commit as the
    // message it gates (see rateCounterAdvanced). A sliding fixed window: `count`
    // messages sent since `windowStart`, reset once the window elapses. The rules
    // are what make the limit real — they refuse an increment past the cap and
    // refuse to reopen the window before it has expired, so a modified client
    // cannot grant itself extra headroom by rewriting the doc.
    // -------------------------------------------------------------------------
    match /rateLimits/{userID} {
      // Window length and per-window cap. Keep in sync with the client's advisory
      // pre-check (MessageStore.sendRateLimit / sendRateWindow).
      function windowSeconds() { return 60; }
      function messageCap() { return 30; }

      allow read: if isSignedIn() && isOwner(userID);

      // First message ever (or first after a full reset that deleted the doc):
      // a fresh window stamped at request.time with a single message in it.
      allow create: if isFullMember()
          && isOwner(userID)
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;

      allow update: if isFullMember()
          && isOwner(userID)
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.count is int
          && (
            // The previous window has elapsed: open a new one at request.time.
            (request.time >= resource.data.windowStart + duration.value(windowSeconds(), 's')
                && request.resource.data.windowStart == request.time
                && request.resource.data.count == 1)
            ||
            // Still inside the open window: increment by one, up to the cap. The
            // window start is pinned, so the window cannot be slid forward to
            // dodge the cap.
            (request.resource.data.windowStart == resource.data.windowStart
                && request.time < resource.data.windowStart + duration.value(windowSeconds(), 's')
                && request.resource.data.count == resource.data.count + 1
                && request.resource.data.count <= messageCap())
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Stay counters — the frequency half of a circle's booking policy.
    // Document id is "{hostUID}_{guestUID}", pinned to the two id fields below.
    //
    // Rules cannot run a query, so "how many times has this person booked me
    // lately" is not a question that can be asked at write time. It is the same
    // problem message rate limiting already has, and the same answer: the guest
    // advances this counter in the same commit as the request, the stay request
    // rule requires the advance through getAfter(), and the cap lives here.
    //
    // The cap and the window length are read from the *host's* circle documents,
    // which the guest cannot write. A guest who tampers with their own counter
    // can only deny themselves slots they were owed.
    //
    // A slot is spent when a request is created and is not returned if the host
    // declines it or the guest cancels. Refunding needs a server that recounts,
    // and there is none deployed; the throttle is therefore on how often someone
    // asks, which is the behaviour a host reaching for it actually wants.
    // -------------------------------------------------------------------------
    match /stayCounters/{counterID} {
      function capCount(data) { return pairCapCount(data.hostUserID, data.guestUserID); }
      function windowDays(data) { return pairCapPeriodDays(data.hostUserID, data.guestUserID); }

      // Both parties may read it: the guest's own client needs it to know when
      // its window rolls over, and the host's to show what a circle is doing.
      allow read: if isSignedIn()
          && (isOwner(resource.data.guestUserID) || isOwner(resource.data.hostUserID));

      // First request this guest has ever sent this host: a fresh window with a
      // single request in it.
      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(['hostUserID', 'guestUserID', 'windowStart', 'count'])
          && request.resource.data.hostUserID is string
          && request.resource.data.guestUserID is string
          && counterID == request.resource.data.hostUserID + '_' + request.resource.data.guestUserID
          && isOwner(request.resource.data.guestUserID)
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;

      allow update: if isFullMember()
          && request.resource.data.keys().hasOnly(['hostUserID', 'guestUserID', 'windowStart', 'count'])
          && request.resource.data.hostUserID == resource.data.hostUserID
          && request.resource.data.guestUserID == resource.data.guestUserID
          && isOwner(resource.data.guestUserID)
          && request.resource.data.count is int
          && (
            // The window has elapsed — or the host has no cap at all, so there
            // is no window to respect. Either way a fresh one opens here.
            ((windowDays(resource.data) == 0
              || request.time >= resource.data.windowStart + duration.value(windowDays(resource.data), 'd'))
                && request.resource.data.windowStart == request.time
                && request.resource.data.count == 1)
            ||
            // Still inside the open window: increment by one, up to the cap.
            // windowStart is pinned, so the window cannot be slid forward to buy
            // headroom — the same trick rateLimits closes.
            (request.resource.data.windowStart == resource.data.windowStart
                && request.resource.data.count == resource.data.count + 1
                && (capCount(resource.data) == 0
                    || request.resource.data.count <= capCount(resource.data)))
          );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Friend edges — bidirectional connections between two users.
    // edgeID = "{smallerUID}_{largerUID}" (canonical alphabetical order).
    // -------------------------------------------------------------------------
    match /friendEdges/{edgeID} {
      allow read: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB);

      // Send a friend request (create pending edge). The key allowlist keeps a
      // modified client from stashing arbitrary extra fields on the edge.
      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly(
               ['userA', 'userB', 'status', 'initiator', 'createdAt', 'updatedAt']
             )
          && request.resource.data.initiator == request.auth.uid
          && (request.resource.data.userA == request.auth.uid
              || request.resource.data.userB == request.auth.uid)
          && request.resource.data.status == "pending"
          && request.resource.data.userA is string
          && request.resource.data.userB is string
          && request.resource.data.userA < request.resource.data.userB
          && request.resource.data.userA != request.resource.data.userB
          // edgeID must match the canonical "{userA}_{userB}" form
          && edgeID == request.resource.data.userA + "_" + request.resource.data.userB
          // A block must stop friend requests too (S11): deleting a declined
          // edge lets it be re-sent forever, so without this a blocked user
          // could keep landing in the blocker's Requests list.
          && !blockedEitherWay(request.resource.data.userA, request.resource.data.userB);

      // Accept a pending request (only the non-initiator may accept).
      allow update: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB)
          && resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.auth.uid != resource.data.initiator
          // The accept may move the status and its timestamp, and nothing else.
          // Pinning the three identity fields by equality (as this rule used to
          // do alone) says what may not change but never bounds what may be
          // *added*: with no allowlist, the accepting party could hang arbitrary
          // extra fields — or a near-megabyte of padding — off an edge document
          // that create carefully allowlists. hasOnly() makes the two symmetric,
          // and subsumes the equality pins on userA/userB/initiator, which are
          // absent from the list and therefore already immutable. createdAt is
          // likewise pinned by omission, which the old rule left free.
          && changedKeys().hasOnly(['status', 'updatedAt']);

      // Either party may delete (decline, cancel, or remove friend).
      allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.userA
              || request.auth.uid == resource.data.userB);
    }

    // -------------------------------------------------------------------------
    // Reviews — post-stay, two-way, public (feature 1).
    //
    // The document id is "{stayRequestID}_{authorUID}". That is what makes "one
    // review per person per stay" a property of the path rather than a query the
    // client could skip: a second review lands on the same document, and the
    // update rule below only lets its own author rewrite it.
    //
    // A review may only be written about a stay that actually finished, by one of
    // its two participants, about the other one. All three facts are read off the
    // stay request itself with an elevated get(), so a client cannot assert them.
    // -------------------------------------------------------------------------
    match /reviews/{reviewID} {
      function stayPath(requestID) {
        return /databases/$(database)/documents/stayRequests/$(requestID);
      }
      function stay(requestID) {
        return get(stayPath(requestID)).data;
      }

      function isValidReviewBody(data) {
        return data.rating is int
            && data.rating >= 1
            && data.rating <= 5
            && isOptionalString(data, 'publicComment', 2000);
      }

      // Reviews are the public reputation record; any full member may read
      // them. Gated to full members (not merely signed in) so an anonymous
      // guest minted from the public web config cannot enumerate them.
      allow read: if isFullMember();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'stayRequestID', 'listingID', 'authorUserID',
               'subjectUserID', 'role', 'rating', 'publicComment',
               'createdAt', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll([
               'stayRequestID', 'listingID', 'authorUserID', 'subjectUserID', 'role', 'rating'
             ])
          && request.resource.data.authorUserID == request.auth.uid
          // The id pins one review per (stay, author).
          && reviewID == request.resource.data.stayRequestID + '_' + request.auth.uid
          && request.resource.data.get('id', reviewID) == reviewID
          && isValidReviewBody(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(stayPath(request.resource.data.stayRequestID))
          // Only a finished stay may be reviewed (feature 4 gates feature 1).
          && stay(request.resource.data.stayRequestID).status == 'completed'
          && stay(request.resource.data.stayRequestID).listingID == request.resource.data.listingID
          // ...by one of its participants, about the other, with the matching role.
          && (
            (request.auth.uid == stay(request.resource.data.stayRequestID).guestUserID
                && request.resource.data.subjectUserID == stay(request.resource.data.stayRequestID).hostUserID
                && request.resource.data.role == 'guestReviewingHost')
            ||
            (request.auth.uid == stay(request.resource.data.stayRequestID).hostUserID
                && request.resource.data.subjectUserID == stay(request.resource.data.stayRequestID).guestUserID
                && request.resource.data.role == 'hostReviewingGuest')
          );

      // The author may revise what they said. Everything that establishes who
      // reviewed whom about which stay is pinned by affectedKeys().
      allow update: if isSignedIn()
          && isOwner(resource.data.authorUserID)
          && changedKeys().hasOnly(['rating', 'publicComment', 'updatedAt'])
          && isValidReviewBody(request.resource.data)
          && request.resource.data.updatedAt == request.time;

      // A review is a record, not a draft. Removal is a moderation action.
      allow delete: if false;

      // The private feedback channel: what the reviewer would say to the
      // reviewed's face but not on their profile. Readable by exactly those two.
      match /private/{docID} {
        function reviewPath() {
          return /databases/$(database)/documents/reviews/$(reviewID);
        }
        function review() {
          return get(reviewPath()).data;
        }

        allow read: if isSignedIn()
            && docID == 'feedback'
            && exists(reviewPath())
            && (isOwner(review().authorUserID) || isOwner(review().subjectUserID));

        allow create, update: if isFullMember()
            && docID == 'feedback'
            && exists(reviewPath())
            && isOwner(review().authorUserID)
            && request.resource.data.keys().hasOnly(['text'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;

        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // References — a friend vouching for a friend, independent of any stay
    // (feature 1). The document id is "{subjectUID}_{authorUID}", so one friend
    // writes at most one reference for another, and `areFriends` means a stranger
    // cannot vouch for anyone at all.
    //
    // Either party may delete: the author because they changed their mind, and
    // the subject because a reference sits on *their* profile and they should not
    // have to keep one they didn't ask for.
    // -------------------------------------------------------------------------
    match /references/{referenceID} {
      // Public reputation record, full members only (see the reviews read).
      allow read: if isFullMember();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'id', 'authorUserID', 'subjectUserID', 'text', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll(['authorUserID', 'subjectUserID', 'text'])
          && request.resource.data.authorUserID == request.auth.uid
          && referenceID == request.resource.data.subjectUserID + '_' + request.auth.uid
          && request.resource.data.get('id', referenceID) == referenceID
          && request.resource.data.subjectUserID is string
          && request.resource.data.subjectUserID != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Vouching is a friendship-gated act.
          && areFriends(request.auth.uid, request.resource.data.subjectUserID)
          // A block severs this the same way it severs a thread (S11).
          && !blockedEitherWay(request.auth.uid, request.resource.data.subjectUserID);

      allow update: if isSignedIn()
          && isOwner(resource.data.authorUserID)
          && changedKeys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn()
          && (isOwner(resource.data.authorUserID) || isOwner(resource.data.subjectUserID));
    }

    // -------------------------------------------------------------------------
    // Reports — the moderation inbox (feature 6). Written by any full member and
    // by the keyword-moderation triggers (admin, which bypass these rules), read
    // and triaged only by a moderator holding the `admin` custom claim. A reporter
    // cannot read their own report back: the inbox is not a channel.
    //
    // Triage states: new → reviewing → actioned | dismissed. Nothing about the
    // report itself (who filed it, against what, why) is editable, so triage can
    // never rewrite the evidence.
    // -------------------------------------------------------------------------
    match /reports/{reportID} {
      allow read: if isAdmin();

      allow create: if isFullMember()
          && request.resource.data.keys().hasOnly([
               'reporterUserID', 'targetType', 'targetID', 'reason',
               'status', 'source', 'createdAt'
             ])
          && request.resource.data.reporterUserID == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() < 2000
          && request.resource.data.targetType in ["user", "listing", "message"]
          // What is being reported. Bounded like every other client-authored
          // string: `reason` was capped but this was not, leaving an unbounded
          // write into a collection the reporter cannot read back — the one
          // shape of abuse a write-only inbox is prone to.
          && request.resource.data.targetID is string
          && request.resource.data.targetID.size() > 0
          && request.resource.data.targetID.size() < 200
          // A fresh report enters triage at the top of the queue, and is filed by
          // a person — `source: "auto"` belongs to the moderation triggers.
          && (isUnset(request.resource.data, 'status') || request.resource.data.status == 'new')
          && (isUnset(request.resource.data, 'source') || request.resource.data.source == 'user')
          // The console orders the queue by createdAt, so a report must not be
          // able to backdate itself out of sight.
          && (isUnset(request.resource.data, 'createdAt')
              || request.resource.data.createdAt == request.time);

      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'moderatorNote', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['new', 'reviewing', 'actioned', 'dismissed']
          && isOptionalString(request.resource.data, 'moderatorNote', 2000)
          && request.resource.data.get('reviewedBy', request.auth.uid) == request.auth.uid;

      allow delete: if false;
    }

  }
}
