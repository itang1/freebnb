rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles. Any signed-in user can read (for showing names in chat/listings);
    // only the owner can create/update their own doc. Deletes are forbidden by default;
    // a Cloud Function should tombstone on account deletion.
    match /users/{userID} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
          && request.auth.uid == userID
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() < 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
          && request.auth.uid == userID
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() < 200
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Listings: any signed-in user can read; only the host can write their own
    match /homes/{homeID} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.hostUserID == request.auth.uid
          && request.resource.data.hostName is string
          && request.resource.data.hostName.size() > 0
          && request.resource.data.hostName.size() < 200;
      allow update, delete: if isSignedIn()
          && resource.data.hostUserID == request.auth.uid;
    }

    // Stay requests: guests create requests, hosts accept/decline, guests can cancel.
    match /stayRequests/{requestID} {
      allow read: if isSignedIn()
          && (request.auth.uid == resource.data.guestUserID
              || request.auth.uid == resource.data.hostUserID);

      allow create: if isSignedIn()
          && request.resource.data.guestUserID == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.hostUserID is string
          && request.resource.data.listingID is string
          && request.resource.data.checkIn is timestamp
          && request.resource.data.checkOut is timestamp
          && request.resource.data.checkOut > request.resource.data.checkIn;

      // Host can accept or decline; guest can cancel.
      allow update: if isSignedIn() && (
          (request.auth.uid == resource.data.hostUserID
              && request.resource.data.status in ["accepted", "declined"]
              && resource.data.status == "pending")
          ||
          (request.auth.uid == resource.data.guestUserID
              && request.resource.data.status == "cancelled"
              && resource.data.status in ["pending", "accepted"])
      );

      allow delete: if false;
    }

    // Messages: user-to-user, not tied to any listing.
    // participants is always sorted [userA, userB], both signed-in user IDs.
    match /messages/{messageID} {
      allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(
               ['id', 'senderUserID', 'text', 'timestamp', 'participants']
             )
          && request.resource.data.senderUserID == request.auth.uid
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] is string
          && request.resource.data.participants[1] is string
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && request.resource.data.participants[0] < request.resource.data.participants[1]
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 5000
          && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
