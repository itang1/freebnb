rules_version = '2';

// Listing photos: organized as /listings/{hostUserID}/{listingID}/{file}.
// Reads require a full (non-anonymous) member. Storage rules cannot read
// Firestore, so they cannot mirror a listing's friends-only `allowedViewerIDs`
// ACL the way firestore.rules does; a full ACL check would need a Cloud
// Function image proxy. This gate is defense in depth: photo URLs live only on the
// friends-only home document, and blocking anonymous sessions denies the cheapest
// enumeration attack. Only the host may write, up to 10 MB, image types only.
//
// That rests on the object path being unguessable, so `get` and `list` are granted
// separately and `list` never: `read` would let a member who knew a host and a
// listing (both public path segments) list the prefix and read back every filename.
// See docs/internal/TODO.md item 13: filenames must be random per upload; the image proxy is the real fix.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{hostUserID}/{listingID}/{allPaths=**} {
      // Full members only. `get`, not `read`: a viewer needs the exact path, which only the
      // friends-only listing document hands out. No `list` rule, so the prefix can't be enumerated.
      allow get: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      // Only a full-member host writes their own listing images. `create, update`, not
      // `write`: the size and content-type checks read `request.resource`, null on a delete,
      // so `write` meant a host could never remove a photo from the client.
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == hostUserID
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Removing your own photo asks only who you are; there's no incoming object to measure.
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == hostUserID;
    }

    // Nothing else is readable or writable from the client.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
