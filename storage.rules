rules_version = '2';

// Listing photos: organized as /listings/{hostUserID}/{listingID}/{file}.
// No client reads at all. Storage rules can't read Firestore, so they can't check a
// listing's friends-only `allowedViewerIDs` the way firestore.rules does. Instead the
// `listingPhotoURLs` callable runs that check and hands out short-lived signed URLs,
// which bypass these rules. Download tokens would bypass them too, so
// `onListingPhotoFinalized` strips the one the SDK mints on upload, and the app never
// asks for one. Only the host may write, up to 10 MB, image types only.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{hostUserID}/{listingID}/{allPaths=**} {
      // No `get` or `list`: every viewer, the host included, goes through `listingPhotoURLs`.
      allow read: if false;

      // Only a full-member host writes their own listing images. `create, update`, not
      // `write`: the size and content-type checks read `request.resource`, null on a delete,
      // so `write` meant a host could never remove a photo from the client.
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == hostUserID
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Removing your own photo asks only who you are; there's no incoming object to measure.
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.uid == hostUserID;
    }

    // Nothing else is readable or writable from the client.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
