{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": ["\"$RESOURCE_DIR/node_modules/.bin/tsc\" --project \"$RESOURCE_DIR/tsconfig.json\""]
  },
  "hosting": {
    "public": "admin",
    "ignore": ["**/.*"],
    "predeploy": ["node \"$PROJECT_DIR/scripts/check_aasa.js\""],
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/.well-known/apple-app-site-association",
        "destination": "/well-known/apple-app-site-association.json"
      },
      { "source": "/i", "destination": "/i/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.googleapis.com; frame-src https://freebnb-6814a.firebaseapp.com https://accounts.google.com https://apis.google.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
