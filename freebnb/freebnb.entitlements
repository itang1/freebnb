<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Required for AppleSignInCoordinator; without it ASAuthorization fails at
	     runtime. Also enable the capability on the App ID in the developer portal
	     (Xcode does this automatically once a team is set). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Lets an invite link open the app instead of Safari. iOS fetches
	     https://freebnb-6814a.web.app/.well-known/apple-app-site-association on
	     install and honours this only if that file names this app's
	     TEAMID.bundleID; see admin/well-known/apple-app-site-association.json,
	     which still needs the real Team ID pasted in. Until then the link opens
	     the web page, which offers to hand off to the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:freebnb-6814a.web.app</string>
	</array>
	<!-- Shared container the app writes the widget snapshot into and the widget
	     extension reads back. The identical group must be enabled on the widget
	     target's entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.poodlestrategy.freebnb</string>
	</array>
</dict>
</plist>
