<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only custom keys live here. GENERATE_INFOPLIST_FILE=YES still merges the
	     INFOPLIST_KEY_* build settings (display name, orientations, etc.) on top
	     of this file at build time. -->
	<!-- Only standard, exempt encryption (HTTPS/ATS). Declaring it here skips the
	     export-compliance question on every App Store Connect upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- App deep links: freebnb://invite?from=<uid> -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.poodlestrategy.freebnb</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>freebnb</string>
			</array>
		</dict>
		<!-- Google Sign-In callback. Scheme is the REVERSED_CLIENT_ID value from
		     GoogleService-Info.plist. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.886039659486-kjmfgjmnhp7so1vcr9rlnehsl8gq8abs</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
