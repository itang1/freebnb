<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only custom keys live here. GENERATE_INFOPLIST_FILE=YES still merges the
	     INFOPLIST_KEY_* build settings (display name, orientations, etc.) on top
	     of this file at build time. -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- App deep links: freebnb://invite?from=<uid> -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.poodlestrategy.freebnb</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>freebnb</string>
			</array>
		</dict>
		<!-- Google Sign-In callback. Add a second dict here whose scheme is the
		     REVERSED_CLIENT_ID value from GoogleService-Info.plist, e.g.
		     <string>com.googleusercontent.apps.1234567890-abcdef</string> -->
	</array>
</dict>
</plist>
