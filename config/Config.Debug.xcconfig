// Debug build configuration.
// Wire this file to the Debug configuration in Xcode:
//   Project > Info > Configurations > Debug > freebnb target → select this file
//
// To use a separate dev Firebase project, place its GoogleService-Info.plist
// at config/GoogleService-Info.Debug.plist and add a Run Script phase that
// copies the right plist to $(SRCROOT)/freebnb/GoogleService-Info.plist before
// the Compile Sources phase.

BUNDLE_ID_SUFFIX = .debug
APP_DISPLAY_NAME = FreeBNB (Dev)
